rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function tenantId() {
      return request.auth.token.tenantId;
    }

    function studioId() {
      return request.auth.token.studioId;
    }

    function isSuperadmin() {
      return isAuthenticated() && role() == 'superadmin';
    }

    function isAdmin() {
      return isAuthenticated() && role() == 'admin';
    }

    function isStudio() {
      return isAuthenticated() && role() == 'studio';
    }

    function isCustomer() {
      return isAuthenticated() && role() == 'customer';
    }

    function isAdminOrAbove() {
      return isAdmin() || isSuperadmin();
    }

    function isStudioOrAbove() {
      return isStudio() || isAdminOrAbove();
    }

    // Tenant isolation: token tenantId must match document tenantId
    function ownTenant(doc) {
      return tenantId() == doc.tenantId;
    }

    // Studio scoping: token studioId must match document studioId
    function ownStudio(doc) {
      return studioId() == doc.studioId;
    }

    // ─── /tenants/{tenantId} ────────────────────────────────────────────────
    // tenantId is the document ID, not a field — standard ownTenant() does not apply.
    match /tenants/{tid} {
      allow read: if isSuperadmin()
                  || (isAdmin() && tenantId() == tid);
      allow write: if false; // Admin SDK only
    }

    // ─── /customers/{userId} ────────────────────────────────────────────────
    match /customers/{userId} {
      allow read: if isAuthenticated()
                  && (request.auth.uid == userId || isStudioOrAbove())
                  && (isSuperadmin() || ownTenant(resource.data));
      // Create via Admin SDK on first login only
      allow create: if false;
      // Customer updates own profile (allowlist enforced in Cloud Function)
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && ownTenant(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['name', 'notificationPrefs', 'updatedAt']);
      // Admin updates via Cloud Function — no direct admin write
      allow delete: if false;
    }

    // ─── /vehicles/{vehicleId} ──────────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && (isStudioOrAbove() || resource.data.ownerId == request.auth.uid);
      allow create: if false; // Cloud Function only
      // Cloud Function only (createVehicle/updateVehicle/archiveVehicle) —
      // the previous isStudioOrAbove() branch had NO field restriction and
      // NO ownStudio() check, letting any studio/admin/superadmin in the
      // tenant hijack a vehicle's ownerId (reassign to any uid) or move it
      // to a different tenant via a direct client write, bypassing Cloud
      // Function schema validation, rate limiting, and audit logging
      // entirely. The customer self-update branch had no legitimate caller
      // either (updateVehicle.ts is the real path for customers too) — no
      // direct client write of any kind is legitimate here (Phase 6 hostile
      // audit P0 finding — same defect class as /jobs and /bookings, fixed
      // in 5291c8e, missed here).
      allow update: if false;
      allow delete: if false;

      // ─── /vehicles/{vehicleId}/protections/{protectionId} ─────────────────
      // Legal/financial protections (insurance/FastTag/PUC/RC/extended
      // warranty) — Phase 2D. Admin/Cloud-Function-created and -verified
      // only; customer is read-own-vehicle-only, no client write of any kind.
      match /protections/{protectionId} {
        allow read: if isAuthenticated()
                    && (isSuperadmin() || ownTenant(resource.data))
                    && (isStudioOrAbove() || resource.data.customerId == request.auth.uid);
        allow write: if false; // Cloud Function only
      }
    }

    // ─── /bookings/{bookingId} ──────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && (isStudioOrAbove() || resource.data.customerId == request.auth.uid);
      allow create: if false; // Cloud Function only
      // Cloud Function only (rescheduleBooking/cancelBooking/etc.) — no
      // legitimate client caller exists (every app mutation already goes
      // through a Cloud Function); a permissive rule here has no upside and
      // was previously missing an ownStudio() check, allowing any
      // studio/admin in the tenant to directly mutate another studio's
      // booking (Phase 5A security audit finding).
      allow update: if false;
      allow delete: if false;
    }

    // ─── /jobs/{jobId} ──────────────────────────────────────────────────────
    match /jobs/{jobId} {
      // Customer can only read their own job — restricted field set enforced in app layer
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && (isStudioOrAbove() || resource.data.customerId == request.auth.uid);
      allow create: if false; // Cloud Function only
      // Cloud Function only (advanceJobStatus/assignBay/confirmManualPayment/
      // etc.) — the previous rule had no ownStudio() check and no field
      // restriction, letting any studio/admin in the tenant directly write
      // ANY field (including totalAmount/paymentStatus/status) on ANY job in
      // the tenant, including another studio's. No legitimate client caller
      // exists — every real mutation already goes through a Cloud Function
      // (Phase 5A security audit P0 finding).
      allow update: if false;
      allow delete: if false; // Jobs are permanent records
    }

    // ─── /approvals/{approvalId} ────────────────────────────────────────────
    match /approvals/{approvalId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && (isStudioOrAbove() || resource.data.customerId == request.auth.uid);
      allow create: if false; // Cloud Function only
      allow update: if false; // Cloud Function only (respondToApproval)
      allow delete: if false;
    }

    // ─── /payments/{paymentId} ──────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && (isStudioOrAbove() || resource.data.customerId == request.auth.uid);
      allow create: if false; // Cloud Function / Admin SDK only
      allow update: if false; // Cloud Function / Admin SDK only
      allow delete: if false; // Immutable
    }

    // ─── /invoices/{invoiceId} ──────────────────────────────────────────────
    match /invoices/{invoiceId} {
      // Customer reads own invoice by document ID (app layer validates ownership).
      // Invoice.publicToken is generated but has no consumer anywhere in the
      // product (Phase 3H audit) — there is no unauthenticated/public invoice
      // view, in this app layer or otherwise. All invoice access requires
      // authentication and passes through the ownership/tenant check below.
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && (isStudioOrAbove() || resource.data.customerId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── /warranties/{warrantyId} ───────────────────────────────────────────
    match /warranties/{warrantyId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && (isStudioOrAbove() || resource.data.customerId == request.auth.uid);
      allow create: if false; // System only, on job seal
      // Phase 2D tightening: warranty terms are historical truth (doc06 §6.4
      // Rule 3) — admin may only record an exceptional revocation, never
      // rewrite the sealed terms themselves.
      allow update: if isAdminOrAbove() && ownTenant(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['revokedAt', 'revokedReason']);
      allow delete: if false; // revokedAt field for exceptional cases
    }

    // ─── /inspections/{jobId} ────────────────────────────────────────────────
    // Phase 4: structured vehicle-condition inspection report, id == jobId.
    // Customer is strictly read-own — can never write, even while a studio
    // inspection is still in_progress. All writes are Cloud-Function-only
    // (startInspection/updateInspection/finalizeInspection).
    match /inspections/{jobId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && (isStudioOrAbove() || resource.data.customerId == request.auth.uid);
      allow write: if false;
    }

    // ─── /memberships/{membershipId} ────────────────────────────────────────
    match /memberships/{membershipId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && (isAdminOrAbove() || resource.data.customerId == request.auth.uid);
      allow create: if false; // Cloud Function only
      allow update: if false; // Cloud Function only
      allow delete: if false;

      // ─── /memberships/{membershipId}/usage/{usageId} ──────────────────────
      match /usage/{usageId} {
        allow read: if isAuthenticated()
                    && (isSuperadmin() || ownTenant(resource.data))
                    && (isAdminOrAbove() || resource.data.customerId == request.auth.uid);
        allow write: if false; // Cloud Function only
      }
    }

    // ─── /membershipPlans/{planId} ──────────────────────────────────────────
    // Admin-managed catalogue (createMembershipPlan/updateMembershipPlan/
    // setMembershipPlanActive) — mirrors /services: no direct client write,
    // even by admin, so every plan change is audited.
    match /membershipPlans/{planId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data));
      allow write: if false;
    }

    // ─── /services/{serviceId} ──────────────────────────────────────────────
    // Catalogue mutations are server-authoritative (createService/updateService/
    // setServiceActive) so they are audited — no direct client write, even by admin.
    match /services/{serviceId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data));
      allow write: if false;
    }

    // ─── /employees/{employeeId} ────────────────────────────────────────────
    // All mutations go through Cloud Functions (addStaffMember/updateStaffRole/
    // deactivateStaffMember) so the Firestore record and the custom claims never
    // drift apart, and every change is audited.
    match /employees/{employeeId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && (isAdminOrAbove() || request.auth.uid == resource.data.authUid);
      allow write: if false;
    }

    // ─── /studioConfig/{studioId} ───────────────────────────────────────────
    // All mutations go through Cloud Functions (updateStudioSettings/addHoliday/
    // removeHoliday/upsertBay) — no direct client write, even by admin, so every
    // business-configuration change is audited.
    match /studioConfig/{studioId} {
      allow read: if isStudioOrAbove()
                  && (isSuperadmin() || ownTenant(resource.data));
      allow write: if false;
    }

    // ─── /auditLog/{entryId} ────────────────────────────────────────────────
    match /auditLog/{entryId} {
      allow read: if isAdminOrAbove()
                  && (isSuperadmin() || ownTenant(resource.data));
      allow create: if false; // Admin SDK / Cloud Function system account only
      allow update: if false; // Immutable
      allow delete: if false; // Immutable
    }

    // ─── /notifications/{notificationId} ────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
                  && (isSuperadmin() || ownTenant(resource.data))
                  && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Function only
    }

    // ─── /invoiceCounters/{tenantId} ────────────────────────────────────────
    // Atomic invoice number counters — Admin SDK only; no client access
    match /invoiceCounters/{tenantId} {
      allow read, write: if false;
    }

    // ─── /paymentEvents/{eventId} ───────────────────────────────────────────
    // Idempotency guard for payment webhooks — Admin SDK only; no client access
    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    // ─── /rateLimits/{key} ──────────────────────────────────────────────────
    // Server-only abuse counters (Phase 3D) — key is server-derived
    // (tenantId__uid__action), never client-supplied. No client access,
    // not even read, so callers cannot time bursts against their own counter.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ─── /bayLocks/{key} ──────────────────────────────────────────────────────
    // Server-only (Phase 7 hostile audit) — deterministic-document touch used
    // solely to give Firestore's transaction conflict detection a reliable
    // signal for bay-assignment races. Carries no meaningful data. No client
    // access of any kind.
    match /bayLocks/{key} {
      allow read, write: if false;
    }

    // ─── /attendance/{recordId} ─────────────────────────────────────────────
    // Studio staff read their tenant's attendance records; an employee can
    // read their own record via the denormalized employeeAuthUid field. All
    // writes go through Cloud Functions (check-in/out, breaks, admin mark).
    match /attendance/{recordId} {
      allow read: if isStudioOrAbove() && ownTenant(resource.data)
                  || (isAuthenticated() && ownTenant(resource.data)
                      && request.auth.uid == resource.data.employeeAuthUid);
      allow write: if false;
    }

    // ─── Deny everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
