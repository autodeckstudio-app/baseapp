# AutoDeck Environment Configuration
# Copy this file to .env.local for local development with emulators
# Never commit .env or .env.local — they are gitignored

# ─── Firebase (Customer/Studio App) ─────────────────────────────────────────
# Get these from the Firebase console for autodeck-dev project
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=autodeck-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=autodeck-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=autodeck-dev.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-app-id

# ─── Firebase (Admin Web) ────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=autodeck-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=autodeck-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=autodeck-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-admin-app-id
# Phase 5B P1-13: reCAPTCHA v3 site key for Firebase App Check (free tier).
# Create one at https://console.firebase.google.com under App Check > Apps,
# registering the admin web app with the reCAPTCHA v3 provider. Required in
# any production build — every admin-only Cloud Function enforces App Check
# server-side, and apps/admin/src/lib/firebase.ts refuses to build without
# this set. Not required for local/emulator development.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace-with-recaptcha-v3-site-key
# Phase 5B P1-15: server-side Admin SDK credential for the /api/session
# route (session-cookie creation/verification/revocation). Only needed if
# the admin app is deployed somewhere WITHOUT Application Default
# Credentials available (e.g. Vercel) — GCP-native hosts (Firebase App
# Hosting, Cloud Run) get ADC automatically from their attached service
# account and can leave this unset. A full service-account JSON (one line),
# never a file path. NEVER commit the real value — set it as a secret in
# your hosting provider's env var store. Not required for local/emulator
# development (apps/admin/src/lib/firebase-admin.ts auto-detects
# FIREBASE_AUTH_EMULATOR_HOST and skips credential loading entirely).
FIREBASE_SERVICE_ACCOUNT_KEY=replace-with-service-account-json-if-not-on-a-gcp-native-host

# ─── Firebase Emulator (local dev only) ─────────────────────────────────────
# Set to "true" to connect to local emulators instead of live Firebase
USE_FIREBASE_EMULATOR=true
FIREBASE_EMULATOR_HOST=localhost

# ─── Razorpay (REQUIRES APPROVAL before production use) ─────────────────────
# Sandbox keys are safe for development — no real charges
# Production keys require India-registered business entity: REQUIRES APPROVAL
RAZORPAY_KEY_ID=replace-with-razorpay-sandbox-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-sandbox-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-signing-secret

# ─── Meta Cloud API / WhatsApp Business ─────────────────────────────────────
# Meta Cloud API: FREE setup; per-message cost ~₹0.115 — REQUIRES APPROVAL
META_WHATSAPP_TOKEN=replace-with-meta-whatsapp-access-token
META_WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
META_WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token

# ─── Resend (email) ─────────────────────────────────────────────────────────
# Free tier: 3,000 emails/month — no approval needed for development
RESEND_API_KEY=replace-with-resend-api-key

# ─── App Environment ────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
