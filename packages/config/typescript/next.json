{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "target": "ES2017",
    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}
