+vi.mock('../lib/auth-service',()=>({onIdTokenChanged:(cb:any)=>{h.callbacks.push(cb);return h.stop},resolveMyCustomerDocResolution:()=>h.resolve(),resolveExistingCustomerDocId:()=>h.staff()}));
+vi.mock('../lib/price-cache',()=>({priceCache:{setScope:()=>{}}}));
+import {CustomerAuthProvider,useAuth} from './useAuth';
+import {CustomerSessionBoundary} from '../ui/CustomerSessionBoundary';
+const customer=(uid:string)=>({uid,getIdTokenResult:vi.fn(async()=>({claims:{role:'customer',tenantId:'fictional'}}))});
+function Consumer(){const a=useAuth();return <div>{a.status==='ready'?`${a.user.uid}:${a.customerDocId}`:a.status}</div>}
+function Fixture(){return <CustomerAuthProvider><CustomerSessionBoundary><Consumer/><Consumer/><Consumer/></CustomerSessionBoundary></CustomerAuthProvider>}
+beforeEach(()=>{h.callbacks=[];h.resolve.mockReset();h.staff.mockReset();h.stop.mockReset();h.resolve.mockResolvedValue({outcome:'resolved',customerDocId:'canonical'})});
+it('one subscription and one resolution serve boundary plus three nested consumers; warm rerender adds none',async()=>{let r:any;await act(async()=>{r=create(<Fixture/>)});expect(h.callbacks).toHaveLength(1);expect(JSON.stringify(r.toJSON())).toContain('Loading your session');const u=customer('A');await act(async()=>h.callbacks[0]!(u));expect(u.getIdTokenResult).toHaveBeenCalledTimes(1);expect(h.resolve).toHaveBeenCalledTimes(1);expect(h.callbacks).toHaveLength(1);expect(JSON.stringify(r.toJSON()).match(/A:canonical/g)).toHaveLength(3);await act(async()=>r.update(<Fixture/>));expect(h.callbacks).toHaveLength(1);expect(h.resolve).toHaveBeenCalledTimes(1);await act(async()=>r.unmount());expect(h.stop).toHaveBeenCalledTimes(1)});
+it('token event drops old private children immediately; stale A result cannot replace newer B; no persistent ownership cache',async()=>{let r:any;await act(async()=>{r=create(<Fixture/>)});const u=customer('A');await act(async()=>h.callbacks[0]!(u));let finish:any;h.resolve.mockImplementationOnce(()=>new Promise(resolve=>{finish=resolve}));let old:any;await act(async()=>{old=h.callbacks[0]!(u);await Promise.resolve();await Promise.resolve()});expect(JSON.stringify(r.toJSON())).not.toContain('A:canonical');expect(JSON.stringify(r.toJSON())).toContain('Loading your session');h.resolve.mockResolvedValue({outcome:'resolved',customerDocId:'B-record'});await act(async()=>h.callbacks[0]!(customer('B')));await act(async()=>{finish({outcome:'resolved',customerDocId:'old-A'});await old});expect(JSON.stringify(r.toJSON())).toContain('B:B-record');expect(JSON.stringify(r.toJSON())).not.toContain('old-A');expect(h.resolve).toHaveBeenCalledTimes(3);await act(async()=>h.callbacks[0]!(null));expect(JSON.stringify(r.toJSON())).not.toContain('B:B-record');await act(async()=>r.unmount())});
+it('staff root takes only read-only resolution and an unmounted pending root cannot reuse a late result',async()=>{let r:any;h.staff.mockResolvedValue({outcome:'absent'});await act(async()=>{r=create(<Fixture/>)});await act(async()=>h.callbacks[0]!({uid:'staff',getIdTokenResult:async()=>({claims:{role:'staff',tenantId:'fictional'}})}));expect(h.staff).toHaveBeenCalledTimes(1);expect(h.resolve).not.toHaveBeenCalled();await act(async()=>r.unmount());await act(async()=>{r=create(<Fixture/>)});expect(h.callbacks).toHaveLength(2);expect(JSON.stringify(r.toJSON())).toContain('Loading your session');await act(async()=>r.unmount())});
