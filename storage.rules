rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function tenantId() {
      return request.auth.token.tenantId;
    }

    function ownsCustomerRef(cid) {
      return firestore.exists(/databases/(default)/documents/customers/$(cid))
          && firestore.get(/databases/(default)/documents/customers/$(cid)).data.authUid == request.auth.uid
          && firestore.get(/databases/(default)/documents/customers/$(cid)).data.tenantId == tenantId()
          && firestore.get(/databases/(default)/documents/customers/$(cid)).data.get("deletedAt", null) == null;
    }

    function currentVehicleOwner(cid, vid, tid) {
      return ownsCustomerRef(cid)
          && firestore.exists(/databases/(default)/documents/vehicles/$(vid))
          && firestore.get(/databases/(default)/documents/vehicles/$(vid)).data.ownerId == cid
          && firestore.get(/databases/(default)/documents/vehicles/$(vid)).data.tenantId == tid
          ;
    }

    function isAdminOrAbove() {
      return role() == 'admin' || role() == 'superadmin';
    }

    function isStudioOrAbove() {
      return role() == 'studio' || isAdminOrAbove();
    }

    // ─── Job photos: {tenantId}/jobs/{jobId}/photos/{filename} ──────────────
    // Owner-scoped via customMetadata.customerId, set by the Cloud Function
    // that issues the signed upload URL (doc08 §8.8) — tenant membership
    // alone is NOT sufficient. Staff get full tenant read, matching the
    // equivalent Firestore /jobs rule (Phase 5A/5B hostile-audit P0 finding:
    // the previous rule let any authenticated tenant member, including an
    // unrelated customer, read any other customer's job photos).
    match /{tid}/jobs/{jobId}/photos/{filename} {
      // Customer binding: GCS lowercases custom-metadata keys stamped via
      // signed-URL PUT headers (customerId -> customerid); SDK/JSON-API
      // uploads keep camelCase. Accept either casing, same uid binding;
      // every other condition (auth, tenant, staff role) is unchanged.
      // Legacy objects lacking vehicle metadata remain staff-readable here;
      // original customers use the inspection-bound private read callable,
      // including deletion tombstones. Storage permits only two Firestore
      // lookups, so do not add an unsafe metadata-only legacy fallback.
      allow read: if isAuthenticated() && tenantId() == tid
                  && (isStudioOrAbove()
                      || ((resource.metadata.get("customerid", "") == ""
                           || resource.metadata.get("customerId", "") == ""
                           || resource.metadata.customerid == resource.metadata.customerId)
                          && (resource.metadata.get("vehicleid", "") == ""
                              || resource.metadata.get("vehicleId", "") == ""
                              || resource.metadata.vehicleid == resource.metadata.vehicleId)
                          && currentVehicleOwner(resource.metadata.get("customerid", resource.metadata.get("customerId", "")), resource.metadata.get("vehicleid", resource.metadata.get("vehicleId", "")), tid)));
      // Studio/admin write via signed upload URL from Cloud Function only
      allow write: if false;
    }

    // ─── Invoice PDFs: {tenantId}/invoices/{invoiceId}/{filename} ───────────
    // Owner-scoped via customMetadata.customerId — see /jobs/photos comment.
    match /{tid}/invoices/{invoiceId}/{filename} {
      allow read: if isAuthenticated() && tenantId() == tid
                  && (isStudioOrAbove() || ownsCustomerRef(resource.metadata.customerId));
      allow write: if false; // Generated by Cloud Function
    }

    // ─── Warranty certificates: {tenantId}/warranties/{warrantyId}/{filename}
    // Owner-scoped via customMetadata.customerId — see /jobs/photos comment.
    match /{tid}/warranties/{warrantyId}/{filename} {
      allow read: if isAuthenticated() && tenantId() == tid
                  && (isStudioOrAbove() || ownsCustomerRef(resource.metadata.customerId));
      allow write: if false; // Generated by Cloud Function on job seal
    }

    // ─── Vehicle photos: {tenantId}/vehicles/{vehicleId}/{filename} ─────────
    // Owner-scoped via customMetadata.ownerId — see /jobs/photos comment.
    match /{tid}/vehicles/{vehicleId}/{filename} {


      // Customer binding: GCS lowercases custom-metadata keys stamped via
      // signed-URL PUT headers (ownerId -> ownerid); SDK/JSON-API uploads keep
      // camelCase. Accept either casing, same uid binding; every other
      // condition (auth, tenant, staff role) is unchanged. See /jobs/photos.
      allow read: if isAuthenticated() && tenantId() == tid
                  && (isStudioOrAbove()
                      || (resource.metadata.get("ownerid", resource.metadata.get("ownerId", "")) == resource.metadata.get("ownerId", resource.metadata.get("ownerid", ""))
                          && currentVehicleOwner(resource.metadata.get("ownerid", resource.metadata.get("ownerId", "")), vehicleId, tid)
                          && firestore.get(/databases/(default)/documents/vehicles/$(vehicleId)).data.get("deletedAt", null) == null));
      // Customer uploads via signed URL from Cloud Function
      allow write: if false;
    }

    // ─── Service photos: service-images/{tenantId}/{filename} ───────────────
    // Public read so the customer app can show them. Only admins of that tenant
    // can add or replace, images only, up to 5 MB. New folder; nothing else changes.
    match /service-images/{tid}/{filename} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdminOrAbove() && tenantId() == tid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Sensitive staff documents are available only through authorized short-lived callable URLs.
    match /{tid}/staffPrivate/{employeeId}/{fileName} { allow read, write: if false; }

    // ─── Deny everything else ────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
