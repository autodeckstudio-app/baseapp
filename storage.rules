rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function tenantId() {
      return request.auth.token.tenantId;
    }

    function isAdminOrAbove() {
      return role() == 'admin' || role() == 'superadmin';
    }

    function isStudioOrAbove() {
      return role() == 'studio' || isAdminOrAbove();
    }

    // ─── Job photos: {tenantId}/jobs/{jobId}/photos/{filename} ──────────────
    match /{tid}/jobs/{jobId}/photos/{filename} {
      allow read: if isAuthenticated() && tenantId() == tid;
      // Studio/admin write via signed upload URL from Cloud Function only
      allow write: if false;
    }

    // ─── Invoice PDFs: {tenantId}/invoices/{invoiceId}/{filename} ───────────
    match /{tid}/invoices/{invoiceId}/{filename} {
      allow read: if isAuthenticated() && tenantId() == tid;
      allow write: if false; // Generated by Cloud Function
    }

    // ─── Warranty certificates: {tenantId}/warranties/{warrantyId}/{filename}
    match /{tid}/warranties/{warrantyId}/{filename} {
      allow read: if isAuthenticated() && tenantId() == tid;
      allow write: if false; // Generated by Cloud Function on job seal
    }

    // ─── Vehicle photos: {tenantId}/vehicles/{vehicleId}/{filename} ─────────
    match /{tid}/vehicles/{vehicleId}/{filename} {
      allow read: if isAuthenticated() && tenantId() == tid;
      // Customer uploads via signed URL from Cloud Function
      allow write: if false;
    }

    // ─── Deny everything else ────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
