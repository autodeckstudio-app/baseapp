export function commitDescriptionRegistryCarry(db:Firestore,readSnapshot:()=>Promise<{sourceHash:string}>){return async(plan:any)=>{const{reviewHash,...body}=plan;if(hash(body)!==reviewHash||plan.kind!=='description-registry-carry-v1'||plan.sourceRequests.length||plan.canonicalWrites.length||plan.priceChanges.length||plan.baselineWrites.length!==64)throw Error('Exact no-money registry carry required');const source=await readSnapshot();if(source.sourceHash!==plan.sourceHash)throw Error('Current source preimage changed');return db.runTransaction(async tx=>{const gate=db.collection('catalogueSourceRuntimeGates').doc('automodz'),registry=db.collection('catalogueSourceRegistries').doc('automodz'),journal=db.collection('catalogueBindingMigrations').doc(reviewHash),prior=(await tx.get(journal)).data();if(prior){if(prior['reviewHash']!==reviewHash||prior['phase']!=='metadata-carried-held')throw Error('Migration requires inspection');return prior}const rows=await Promise.all([tx.get(gate),tx.get(registry),tx.get(db.collection('cataloguePublishLocks').doc('automodz')),tx.get(db.collection('catalogueSourceAccessLocks').doc('automodz'))]),[runtime,accepted,publisher,lock]=rows.map(s=>s.data());if(accepted||runtime?.['state']!=='maintenance'||runtime?.['reviewHash']!==reviewHash||runtime?.['oldHandlersQuiesced']!==true||runtime?.['allHandlersVersionVerified']!==true||runtime?.['activeOperationId']||publisher?.['activePublishId']||publisher?.['activeSharedOperationId']||lock?.['activeOperationId'])throw Error('Exact idle all-handler maintenance required');const refs=plan.baselineWrites.map((b:any)=>db.collection('catalogueSourcePriceBaselines').doc(b.serviceId)),baselines=await Promise.all(refs.map((ref:any)=>tx.get(ref)));if(baselines.some((s:any,i:number)=>hash(s.data()??null)!==plan.baselineWrites[i].beforeHash))throw Error('Accepted baseline preimage changed');const canonicalIds=Object.keys(plan.canonicalHashes);if(canonicalIds.length!==74||canonicalIds.some(id=>!plan.registry.bindings.some((b:any)=>b.serviceId===id)))throw Error('Exact mapped canonical identities required');const services=await Promise.all(canonicalIds.map(id=>tx.get(db.collection('services').doc(id))));if(services.some((s,i)=>!s.exists||s.data()?.['tenantId']!=='automodz'||hash(s.data())!==plan.canonicalHashes[canonicalIds[i]!]))throw Error('Current canonical preimages changed');const done={phase:'metadata-carried-held',reviewHash,sourceHash:plan.sourceHash,registryVersion:plan.registry.version,unchangedMoney:true,unchangedSource:true};for(let i=0;i<refs.length;i++)tx.set(refs[i],plan.baselineWrites[i].after);tx.create(registry,plan.registry);tx.create(journal,done);tx.update(gate,{mappingVersion:plan.registry.version,baselineCarryVerified:true,sourceHash:plan.sourceHash,privateReadVerified:false,structuralReadVerified:false});return done;})};}
