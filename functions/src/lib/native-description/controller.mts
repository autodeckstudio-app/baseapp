export function descriptionController(db:Firestore,actor:Actor,ports:{source:any;projection:any},expected:{mappingVersion:string;runtimeDigest:string}){const idle=qualifiedDescriptionRuntimeGate(db,expected),review=nativeDescriptionReview(db,ports.projection,actor,{readSnapshot:ports.source.readSnapshot,assertQualifiedRuntime:idle}),reservation=descriptionReservation(db,actor,{readSnapshot:ports.source.readSnapshot,readProjection:ports.projection.read});return{async review(raw:unknown){const p=z.object({draftId:id,expectedVersion:z.number().int().positive()}).strict().parse(raw),draft=(await db.collection('catalogueDrafts').doc(p.draftId).get()).data();return draft?.['state']==='reviewed'?review.prepare(p):review.review(p)},prepare:review.prepare.bind(review),async publish(raw:unknown){const p=apply.parse(raw);await idle();const reserved=await reservation.reserve(p);if(reserved.phase==='complete')return reserved;const authority=reserved['sourceAuthority'];if(!authority)throw Error('Saved own description authority required');const operationId=reserved['id'] as string,api=nativeDescriptionLifecycle(descriptionCommitGatedDb(db),actor,{source:ports.source,projection:{read:ports.projection.read,write:(service:any,hash:string)=>ports.projection.writeReviewed({serviceId:service.id,name:service.name,brand:service.brand??null,description:service.description,active:service.active},hash)},approval:()=>authority,assertQualifiedRuntime:qualifiedDescriptionRuntimeGate(db,expected,operationId)});return api.apply({id:p.id,hash:p.hash})},async status(raw:unknown){if(!actor.appCheckVerified||actor.tenantId!=='automodz'||!['admin','superadmin'].includes(actor.role))throw Error('Verified description admin required');const p=z.object({operationId:id}).strict().parse(raw),op=(await db.collection('catalogueNativeDescriptionOperations').doc(p.operationId).get()).data();if(!op||op['tenantId']!==actor.tenantId||op['actor']!==actor.uid)throw Error('Own saved operation required');return{operationId:p.operationId,phase:op['phase'],customerPublication:op['phase']==='complete'?op['customerPublication']:null}}};}
