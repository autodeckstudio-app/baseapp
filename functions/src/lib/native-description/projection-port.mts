export function descriptionProjectionPort(db:Firestore,reader:any,send:(intent:unknown)=>Promise<unknown>){return{...reader,async writeReviewed(row:any,expectedRowHash:string){const intent=await db.runTransaction(async tx=>{const lock=(await tx.get(db.collection('cataloguePublishLocks').doc('automodz'))).data(),id=lock?.['descriptionOperationId'];if(typeof id!=='string'||lock?.['activePublishId']!==id)throw Error('Exact description publish lock required');const op=(await tx.get(db.collection('catalogueNativeDescriptionOperations').doc(id))).data(),gate=(await tx.get(db.collection('catalogueSourceRuntimeGates').doc('automodz'))).data(),source=(await tx.get(db.collection('catalogueSourceAccessLocks').doc('automodz'))).data();if(!op||op['phase']!=='projection-in-flight'||op['projectionAttemptClaimed']!==true||op['projectionTransportAttemptClaimed']===true||op['projectionBeforeHash']!==expectedRowHash||gate?.['state']!=='ready'||gate?.['activeOperationId']!==id||gate?.['oldHandlersQuiesced']!==true||gate?.['privateReadVerified']!==true||gate?.['structuralReadVerified']!==true||gate?.['baselineCarryVerified']!==true||source?.['activeOperationId']!==id||source?.['kind']!=='description')throw Error('Held projection reservation required');const p=op['plan'],{reviewHash,...body}=p;if(hash(body)!==reviewHash||op['ticketHash']!==reviewHash)throw Error('Frozen source plan changed');const registry=(await tx.get(db.collection('catalogueSourceRegistries').doc('automodz'))).data(),baselines=await Promise.all(p.priceBaselines.map((b:any)=>tx.get(db.collection('catalogueSourcePriceBaselines').doc(b.serviceId))));if(hash(registry??null)!==p.beforeRegistryHash||baselines.some((b:any,i:number)=>hash(b.data()??null)!==p.priceBaselines[i].documentHash))throw Error('Registry or accepted baseline changed');const service=(await tx.get(db.collection('services').doc(p.serviceId))).data(),draft=(await tx.get(db.collection('catalogueDrafts').doc(p.canonicalReview.draftId))).data();if(hash(service??null)!==p.beforeServiceHash||draft?.['state']!=='publishing'||hash({...draft,state:'reviewed'})!==op['draftHash'])throw Error('Frozen projection preimages changed');const exact={serviceId:p.serviceId,name:service!['name'],brand:service!['brand']??null,description:p.afterDescription,active:service!['active']};if(hash(exact)!==hash(row))throw Error('Exact description-only row required');tx.update(db.collection('catalogueNativeDescriptionOperations').doc(id),{projectionTransportAttemptClaimed:true});return signedWorkerWriteIntent({operation:'write-reviewed-public-row',tenantId:'automodz',publishId:id,draftId:p.canonicalReview.draftId,reviewHash:p.canonicalReview.reviewHash,expectedRowHash,row:exact})});return send(intent)}};}
