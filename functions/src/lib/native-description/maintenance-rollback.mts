import{createHash}from'node:crypto';import{hash}from'./fingerprint.mjs';import{requiredCatalogueGuardTargets}from'./maintenance-plan.mjs';
interface SavedTarget{name:string;buildConfig:any;serviceConfig:any;environment:string;labels:Record<string,string>}
interface Input{saved:SavedTarget[];policies:Record<string,unknown>;archiveHashes:Record<string,string>;currentGate:Record<string,unknown>;metadataCarried:boolean;sourceUnchanged:boolean;canonicalUnchanged:boolean;baselinesUnchangedExceptBinding:boolean;noSourceAttempts:boolean;locksIdle:boolean}
/** Pure rollback request preparation. Never runs patches or unholds a gate.
 * Includes exact original source generation/config/IAM. Once metadata has
 * moved, restoring handlers alone is unsafe: caller must keep maintenance,
 * restore only exact preimage registry/binding metadata, verify and drain the
 * replaced versions before reopening the original numeric configuration. */
export function prepareCatalogueMaintenanceRollback(input:Input,archives:Record<string,Uint8Array>){
 const names=[...requiredCatalogueGuardTargets,'cataloguePriceSourceWorker'];
 if(input.currentGate['state']!=='maintenance'||input.currentGate['activeOperationId']||!input.locksIdle||!input.sourceUnchanged||!input.canonicalUnchanged||!input.baselinesUnchangedExceptBinding||!input.noSourceAttempts||input.saved.length!==names.length||new Set(input.saved.map(t=>t.name)).size!==names.length||names.some(n=>!input.saved.some(t=>t.name===n)))throw Error('Exact no-effect idle held rollback preimages required');
 const requests=input.saved.map(t=>{const source=t.buildConfig?.source?.storageSource,a=archives[t.name],policy=input.policies[t.name];if(!source?.generation||!source.bucket||!source.object||!a?.length||createHash('sha256').update(a).digest('hex')!==input.archiveHashes[t.name]||!policy||!t.serviceConfig?.serviceAccountEmail||!t.serviceConfig?.timeoutSeconds)throw Error('Exact verified rollback source/config/IAM required: '+t.name);const s=t.serviceConfig,build=t.buildConfig;return{name:t.name,url:'https://cloudfunctions.googleapis.com/v2/projects/autodeck-studio/locations/asia-south1/functions/'+t.name,method:'PATCH',updateMask:'buildConfig,serviceConfig,labels',body:{name:'projects/autodeck-studio/locations/asia-south1/functions/'+t.name,buildConfig:{runtime:build.runtime,entryPoint:build.entryPoint,source:build.source,...(build.environmentVariables?{environmentVariables:build.environmentVariables}:{}),...(build.serviceAccount?{serviceAccount:build.serviceAccount}:{})},serviceConfig:Object.fromEntries(['timeoutSeconds','environmentVariables','maxInstanceCount','minInstanceCount','ingressSettings','serviceAccountEmail','availableMemory','maxInstanceRequestConcurrency','availableCpu','vpcConnector','vpcConnectorEgressSettings','secretEnvironmentVariables','secretVolumes'].filter(k=>s[k]!==undefined).map(k=>[k,s[k]])),labels:t.labels},expectedPolicy:policy};});
 const body={kind:'catalogue-held-rollback-v1',requests,metadataRestoreRequired:input.metadataCarried,restoreCanonical:false,restoreSource:false,restoreMoney:false,gateState:'maintenance',reopenAllowed:false,postconditions:['exact rollback artifact/config/IAM readback','exact metadata preimage validation','replaced-handler drain','source and canonical unchanged','accepted publication money/history unchanged','all locks idle']};return{...body,reviewHash:hash(body)};
}
