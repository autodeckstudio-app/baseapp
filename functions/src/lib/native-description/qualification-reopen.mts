import type{Firestore,Transaction}from'firebase-admin/firestore';
import{hash}from'./fingerprint.mjs';
import{bindingHash}from'../price-list-sync-plan.js';
import{requiredCatalogueGuardTargets}from'./maintenance-plan.mjs';
const digest=/^[a-f0-9]{64}$/;
interface DeploymentEvidence{mainCommit:string;runtimeDigest:string;guardDigests:Record<string,string>;drainStartedAt:string;observedAt:string;maxOldRequestSeconds:number;sourceHash:string;registryHash:string;carryReviewHash:string;mappingVersion:string}
interface ProtocolReceipt{id:string;kind:string;sourceHash:string;runtimeDigest:string;mappingVersion:string;registryHash:string;oneTimeClaimVerified:boolean;replayRefused:boolean;sourceEffects:number;protocolHash:string}
/** Controller/operator composition only, never a callable/request-body port.
 * verifyDeployment must READ current platform artifacts/serving identities,
 * invoker IAM and drain evidence. Its result is compared twice, not accepted
 * from an Admin/client's booleans. This module cannot mint that evidence. */
export function descriptionQualificationLifecycle(db:Firestore,ports:{verifyDeployment:()=>Promise<DeploymentEvidence>;readSource:()=>Promise<{sourceHash:string}>;probe:(id:string)=>Promise<ProtocolReceipt>}){
 function validate(e:DeploymentEvidence){if(!/^[a-f0-9]{40}$/.test(e.mainCommit)||![e.runtimeDigest,e.sourceHash,e.registryHash,e.carryReviewHash].every(x=>digest.test(x))||Object.keys(e.guardDigests).length!==requiredCatalogueGuardTargets.length||requiredCatalogueGuardTargets.some(k=>!digest.test(e.guardDigests[k]??''))||!Number.isSafeInteger(e.maxOldRequestSeconds)||e.maxOldRequestSeconds<540||!Number.isFinite(Date.parse(e.observedAt))||!Number.isFinite(Date.parse(e.drainStartedAt))||Date.parse(e.observedAt)-Date.parse(e.drainStartedAt)<e.maxOldRequestSeconds*1000)throw Error('Current main-only drained deployment evidence required')}
 async function held(tx:Transaction,e:DeploymentEvidence){const[g,r,j,s,p]=await Promise.all([tx.get(db.doc('catalogueSourceRuntimeGates/automodz')),tx.get(db.doc('catalogueSourceRegistries/automodz')),tx.get(db.doc('catalogueBindingMigrations/'+e.carryReviewHash)),tx.get(db.doc('catalogueSourceAccessLocks/automodz')),tx.get(db.doc('cataloguePublishLocks/automodz'))]);const gate=g.data(),journal=j.data(),registry=r.data();if(gate?.['state']!=='maintenance'||gate['tenantId']!=='automodz'||gate['reviewHash']!==e.carryReviewHash||gate['mappingVersion']!==e.mappingVersion||gate['sourceHash']!==e.sourceHash||gate['baselineCarryVerified']!==true||gate['activeOperationId']||gate['oldHandlersQuiesced']!==true||gate['allHandlersVersionVerified']!==true||hash(registry??null)!==e.registryHash||registry?.['version']!==e.mappingVersion||journal?.['phase']!=='metadata-carried-held'||journal['reviewHash']!==e.carryReviewHash||journal['sourceHash']!==e.sourceHash||s.data()?.['activeOperationId']||p.data()?.['activePublishId']||p.data()?.['activeSharedOperationId'])throw Error('Exact idle carried maintenance required');return registry}
 return{async qualifyAndReopen(id:string){
  if(!/^qualification_[a-f0-9]{32}$/.test(id))throw Error('Unique no-effect qualification identifier required');
  const e=await ports.verifyDeployment();validate(e);if((await ports.readSource()).sourceHash!==e.sourceHash)throw Error('Current structural preimage changed');
  const ref=db.collection('catalogueRuntimeQualifications').doc(id),evidenceHash=hash(e);
  await db.runTransaction(async tx=>{const registry=await held(tx,e),prior=await tx.get(ref);if(prior.exists)throw Error('Qualification already attempted; inspect, never replay');const bindings=registry!['bindings'].filter((b:{policy:string})=>b.policy==='fixed');if(bindings.length!==64)throw Error('Exact accepted baseline coverage required');const baselines=await Promise.all(bindings.map((b:{serviceId:string})=>tx.get(db.collection('catalogueSourcePriceBaselines').doc(b.serviceId))));if(new Set(bindings.map((b:{serviceId:string})=>b.serviceId)).size!==64||baselines.some((b,i)=>!b.exists||b.data()?.['tenantId']!=='automodz'||b.data()?.['mappingVersion']!==e.mappingVersion||b.data()?.['bindingHash']!==bindingHash(bindings[i])||!b.data()?.['publicationId']))throw Error('Current carried baselines required');tx.create(ref,{kind:'description-no-effect-qualification-v1',id,tenantId:'automodz',phase:'prepared',sourceHash:e.sourceHash,runtimeDigest:e.runtimeDigest,mappingVersion:e.mappingVersion,registryHash:e.registryHash,carryReviewHash:e.carryReviewHash,deploymentEvidence:e,evidenceHash,baselineHashes:Object.fromEntries(baselines.map(b=>[b.id,hash(b.data())])),attemptClaimed:false});});
  const receipt=await ports.probe(id),{protocolHash,...body}=receipt;
  if(hash(body)!==protocolHash||receipt.id!==id||receipt.kind!=='description-no-effect-qualification-v1'||receipt.sourceHash!==e.sourceHash||receipt.runtimeDigest!==e.runtimeDigest||receipt.mappingVersion!==e.mappingVersion||receipt.registryHash!==e.registryHash||receipt.oneTimeClaimVerified!==true||receipt.replayRefused!==true||receipt.sourceEffects!==0)throw Error('Exact actual private no-effect receipt required');
  const after=await ports.verifyDeployment();validate(after);const{observedAt:beforeTime,...beforeStable}=e,{observedAt:afterTime,...afterStable}=after;if(hash(beforeStable)!==hash(afterStable)||Date.parse(afterTime)<Date.parse(beforeTime)||(await ports.readSource()).sourceHash!==e.sourceHash)throw Error('Deployment or source changed during qualification');
  return db.runTransaction(async tx=>{await held(tx,e);const record=(await tx.get(ref)).data();if(record?.['phase']!=='prepared'||record['attemptClaimed']!==true||record['evidenceHash']!==evidenceHash)throw Error('Actual one-time qualification claim required');const keys=Object.keys(record['baselineHashes']);if(keys.length!==64)throw Error('Exact64 accepted baseline hashes required');const baselines=await Promise.all(keys.map(k=>tx.get(db.collection('catalogueSourcePriceBaselines').doc(k))));if(baselines.some((b,i)=>hash(b.data()??null)!==record['baselineHashes'][keys[i]!]))throw Error('Accepted baseline changed during qualification');tx.update(ref,{phase:'qualified',receipt,verifiedDeployment:after});tx.update(db.doc('catalogueSourceRuntimeGates/automodz'),{state:'ready',runtimeDigest:e.runtimeDigest,privateReadVerified:true,structuralReadVerified:true,qualificationId:id,qualificationReceiptHash:protocolHash});return{id,phase:'qualified',runtimeDigest:e.runtimeDigest,sourceEffects:0}});
 }};
}
