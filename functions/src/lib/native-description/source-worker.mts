import{attachedCatalogueRuntimeIdentity,CATALOGUE_CONTROLLER}from'../catalogue-runtime-composition.js';import{googleCatalogueIdentityVerifier}from'../catalogue-google-identity.js';import{structuralGoogleReader,PRINCIPAL}from'./source-reader.mjs';import{privateStructuralReadHandler}from'./source-read-boundary.mjs';import{privateDescriptionResolverClient}from'./private-client.mjs';import{boundedNativeDescriptionWriter}from'./source-plan.mjs';
/** Private factory only. Existing isolated source identity, fixed workbook,
