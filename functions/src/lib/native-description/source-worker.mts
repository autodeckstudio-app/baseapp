export async function composePrivateDescriptionSource(config:{audience:string;resolver:{endpoint:string;audience:string}}){const attached=await attachedCatalogueRuntimeIdentity(PRINCIPAL),read=structuralGoogleReader(attached,fetch),verify=googleCatalogueIdentityVerifier({audience:config.audience,controllerPrincipal:CATALOGUE_CONTROLLER}),inspect=privateStructuralReadHandler(config.audience,verify,read),resolver=privateDescriptionResolverClient(config.resolver,attached.getIdToken),writer=boundedNativeDescriptionWriter({auth:attached,http:fetch,readSnapshot:read,resolve:resolver.resolveAttempt,resolveForInspection:resolver.resolveInspection,claimAttempt:resolver.claimAttempt});return async(req:{method:string;authorization?:string;body:unknown})=>{if((req.body as any)?.operation==='inspect-fixed-native-source')return inspect(req);if(req.method!=='POST')return{status:405,body:{error:'Method unavailable'}};try{if(!req.authorization?.startsWith('Bearer ')||req.authorization.length>16384)throw Error('Private caller required');await verify(req.authorization.slice(7),config.audience);const p=req.body as any;if(!p||Object.keys(p).sort().join('|')!=='operation|operationId'||!['apply-fixed-description','qualify-fixed-description-no-effect'].includes(p.operation)||!(/^[A-Za-z0-9_-]{1,128}$/).test(p.operationId??''))throw Error('Exact saved operation required');if(p.operation==='qualify-fixed-description-no-effect')return{status:200,body:await runDescriptionQualificationProbe(p.operationId,resolver,read)};const proof=await writer.write(p.operationId);return{status:200,body:{operationId:p.operationId,proof}}}catch{return{status:409,body:{error:'Source outcome unconfirmed; inspect read-only recovery'}}}};}
