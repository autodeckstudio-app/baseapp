# AutoDeck studio-mobile — local development, emulator-only.
# Copy to .env (gitignored) if you need to override a default.
# Every value below is either an obviously-fake placeholder safe for the
# Firebase Auth EMULATOR only, or points at the local backend — never a
# real credential. EXPO_PUBLIC_* is Expo's mechanism for exposing a value
# to app code, so nothing secret ever belongs here.
#
# EXPO_PUBLIC_API_BASE_URL: `localhost` only works from the iOS Simulator
# or Android emulator's special loopback. A physical device needs your
# development machine's LAN IP instead, e.g. http://192.168.1.23:3000.

EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-autodeck.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-autodeck
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
