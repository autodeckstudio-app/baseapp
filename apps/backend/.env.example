# AutoDeck backend — Phase 1, emulator-only.
# Names only, per the env-as-contract convention. No secrets — the emulator
# needs none. FIREBASE_PROJECT_ID must stay a demo-* alias; the app refuses
# to start otherwise (fail closed, see src/auth/firebase-admin.provider.ts).

NODE_ENV=development
PORT=3000
FIREBASE_PROJECT_ID=demo-autodeck
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Phase 2J: Razorpay is the only payment provider. These are obviously-fake
# placeholders for local/emulator use only — never a real key pair or
# webhook secret. RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET authenticate outbound
# Orders/Refunds API calls (never actually reached by tests, which mock the
# injected Razorpay client); RAZORPAY_WEBHOOK_SECRET is used only to verify
# inbound webhook signatures and is a separate secret from the key pair.
RAZORPAY_KEY_ID=rzp_test_dummy_key_id_for_emulator_only
RAZORPAY_KEY_SECRET=dummy_key_secret_for_emulator_only
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret_for_emulator_only
