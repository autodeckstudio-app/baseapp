---
import Base from '../layouts/Base.astro';
---
<Base
  title="AutoDeck · Complete car care. All under one roof."
  description="Detailing, paint protection, ceramic, washing, garage and modification at one address in Ellisbridge, Ahmedabad, with your car's whole record in the app you hold. Grand opening Friday 16 October 2026."
  page="home"
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-fallback" aria-hidden="true"></div>
    <div class="hero-gl" id="hero-gl" aria-hidden="true"></div>
    <div class="rail">AutoDeck · Ellisbridge, Ahmedabad · Est. 2026</div>
    <div class="hero-inner">
      <p class="hero-eyebrow rv-e">Ellisbridge · Ahmedabad</p>
      <h1 class="hero-title">
        <span class="line"><span>Complete</span></span>
        <span class="line"><span>car care.</span></span>
        <span class="line"><span>All under <em>one roof.</em></span></span>
      </h1>
      <p class="hero-sub rv-e">Detailing, paint protection, ceramic, washing, garage and modification at one address, with your car's whole record in the app you hold.</p>
      <div class="hero-actions rv-e">
        <a class="btn magnetic" href="https://app.autodeck.in"><span class="btn-label">Get the app</span><span class="arr">→</span></a>
        <a class="btn ghost magnetic" href="tel:+919898679711"><span class="btn-label">Call the studio</span></a>
      </div>
    </div>
    <div class="hero-meta">
      <div class="cell">
        <span class="label">Grand opening</span>
        <span class="value">Friday 16 October</span>
      </div>
      <div class="cell">
        <span class="label">Four zones · one address</span>
        <span class="value">Garage · Detailing Lab · Wash Studio · Lounge</span>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>Performance Garage</span><span class="dot">●</span><span class="hollow">Detailing Lab</span><span class="dot">●</span><span>Wash Studio</span><span class="dot">●</span><span class="hollow">Accessory Lounge</span><span class="dot">●</span>
      <span>Performance Garage</span><span class="dot">●</span><span class="hollow">Detailing Lab</span><span class="dot">●</span><span>Wash Studio</span><span class="dot">●</span><span class="hollow">Accessory Lounge</span><span class="dot">●</span>
    </div>
  </div>

  <!-- MANIFESTO -->
  <section class="section manifesto">
    <div class="manifesto-grid">
      <p class="manifesto-copy" id="manifesto">Your car doesn't need three appointments. One studio details it, protects it, repairs it and washes it. One app holds the job card, the photos, the warranty and the reminders. What was promised at booking is what shows up on the invoice. <span class="hl">That's the whole idea.</span></p>
      <figure class="manifesto-figure rv px-img">
        <img src="/assets/img/car-lights.jpg" alt="A car under the linear lights of the AutoDeck Detailing Lab" data-px />
        <figcaption><span>Detailing Lab</span><span>Render · Studio design</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- THE FOUR ROOMS · index of pages -->
  <section class="section doors">
    <div class="sec-head rv">
      <span class="sec-index">01 / 04</span>
      <span class="sec-kicker">The studio, in four rooms</span>
    </div>
    <div class="door-list">
      <a class="door rv" href="/services">
        <span class="door-idx">01</span>
        <span class="door-body">
          <span class="door-name">Services</span>
          <span class="door-hook">Six crafts under one roof. Nothing outsourced, nothing hidden.</span>
        </span>
        <span class="door-arr" aria-hidden="true">→</span>
        <span class="door-fill" aria-hidden="true"></span>
      </a>
      <a class="door rv" href="/app">
        <span class="door-idx">02</span>
        <span class="door-body">
          <span class="door-name">The App</span>
          <span class="door-hook">The job card, the photos, the warranty. The record follows the car.</span>
        </span>
        <span class="door-arr" aria-hidden="true">→</span>
        <span class="door-fill" aria-hidden="true"></span>
      </a>
      <a class="door rv" href="/lounge">
        <span class="door-idx">03</span>
        <span class="door-body">
          <span class="door-name">The Lounge</span>
          <span class="door-hook">Merch and studio-approved care. On the shelf from opening day.</span>
        </span>
        <span class="door-arr" aria-hidden="true">→</span>
        <span class="door-fill" aria-hidden="true"></span>
      </a>
      <a class="door rv" href="/visit">
        <span class="door-idx">04</span>
        <span class="door-body">
          <span class="door-name">The Studio</span>
          <span class="door-hook">Sunbeam Complex, Ellisbridge. Doors open Friday 16 October.</span>
        </span>
        <span class="door-arr" aria-hidden="true">→</span>
        <span class="door-fill" aria-hidden="true"></span>
      </a>
    </div>
  </section>

  <!-- OPENING · countdown -->
  <section class="wraps">
    <div class="wraps-bg px-img"><img src="/assets/img/covered-car.jpg" alt="A car under wraps inside the studio" data-px /></div>
    <div class="wraps-inner">
      <div class="sec-head rv">
        <span class="sec-index">11 · 10</span>
        <span class="sec-kicker" style="color: var(--paper-dim);">The reveal · Sunday 11 October</span>
      </div>
      <h2 class="sec-title rv">Under wraps<br /><em>until eleven ten.</em></h2>
      <p class="cd-caption rv">Grand opening · Friday 16 October</p>
      <div class="countdown rv" id="countdown" data-target="2026-10-16T10:00:00+05:30" role="status">
        <span class="unit"><b class="num" data-cd="d">00</b><i class="cap">days</i></span>
        <span class="unit"><b class="num" data-cd="h">00</b><i class="cap">hours</i></span>
        <span class="unit"><b class="num" data-cd="m">00</b><i class="cap">min</i></span>
        <span class="unit"><b class="num" data-cd="s">00</b><i class="cap">sec</i></span>
      </div>
      <p class="wraps-note rv">The first look lands on <a class="inline" href="https://instagram.com/autodeck.studio" target="_blank" rel="noopener">@autodeck.studio</a> on 11 October. Doors open Friday 16 October, 10 am.</p>
    </div>
  </section>
</Base>
