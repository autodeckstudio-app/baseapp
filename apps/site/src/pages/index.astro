---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AutoDeck — Complete car care. All under one roof.</title>
  <meta name="description" content="Detailing, paint protection, ceramic, washing, garage and modification at one address in Ellisbridge, Ahmedabad — and your car's whole record in the app you hold." />
  <meta property="og:title" content="AutoDeck — Complete car care. All under one roof." />
  <meta property="og:description" content="Detailing, paint protection, ceramic, washing, garage and modification at one address in Ellisbridge, Ahmedabad." />
  <meta property="og:image" content="/assets/og.png" />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="grain" aria-hidden="true"></div>

  <header class="site-head">
    <a class="brand" href="#top" data-scroll><img src="/assets/logo-horizontal.svg" alt="AutoDeck" /></a>
    <nav>
      <a href="#services" data-scroll>Services</a>
      <a href="#app" data-scroll>App</a>
      <a href="#lounge" data-scroll>Shop</a>
      <a href="#visit" data-scroll>Visit</a>
      <a class="head-cta" href="https://baseapp-customer.vercel.app">Book a slot</a>
    </nav>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-fallback" aria-hidden="true"></div>
      <div class="hero-gl" id="hero-gl" aria-hidden="true"></div>
      <div class="rail">AutoDeck — Ellisbridge, Ahmedabad — Est. 2026</div>
      <div class="hero-inner">
        <p class="hero-eyebrow rv-e">Ellisbridge · Ahmedabad</p>
        <h1 class="hero-title">
          <span class="line"><span>Complete</span></span>
          <span class="line"><span>car care.</span></span>
          <span class="line"><span>All under <em>one roof.</em></span></span>
        </h1>
        <p class="hero-sub rv-e">Detailing, paint protection, ceramic, washing, garage and modification at one address — and your car's whole record in the app you hold.</p>
        <div class="hero-actions rv-e">
          <a class="btn magnetic" href="https://baseapp-customer.vercel.app"><span class="btn-label">Get the app</span><span class="arr">→</span></a>
          <a class="btn ghost magnetic" href="tel:+919898679711"><span class="btn-label">Call the studio</span></a>
        </div>
      </div>
      <div class="hero-meta">
        <div class="cell">
          <span class="label">Grand opening</span>
          <span class="value">Opening soon</span>
        </div>
        <div class="cell">
          <span class="label">Four zones · one address</span>
          <span class="value">Garage · Detailing Lab · Wash Studio · Lounge</span>
        </div>
      </div>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>Performance Garage</span><span class="dot">●</span><span class="hollow">Detailing Lab</span><span class="dot">●</span><span>Wash Studio</span><span class="dot">●</span><span class="hollow">Accessory Lounge</span><span class="dot">●</span>
        <span>Performance Garage</span><span class="dot">●</span><span class="hollow">Detailing Lab</span><span class="dot">●</span><span>Wash Studio</span><span class="dot">●</span><span class="hollow">Accessory Lounge</span><span class="dot">●</span>
      </div>
    </div>

    <!-- MANIFESTO -->
    <section class="section manifesto">
      <div class="manifesto-grid">
        <p class="manifesto-copy" id="manifesto">Your car doesn't need three appointments. One studio details it, protects it, repairs it and washes it. One app holds the job card, the photos, the warranty and the reminders. What was promised at booking is what shows up on the invoice — <span class="hl">that's the whole idea.</span></p>
        <figure class="manifesto-figure rv px-img">
          <img src="/assets/img/car-lights.jpg" alt="A car under the linear lights of the AutoDeck Detailing Lab" data-px />
          <figcaption><span>Detailing Lab</span><span>Render · Studio design</span></figcaption>
        </figure>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="section services" id="services">
      <div class="sec-head rv">
        <span class="sec-index">01 / 06</span>
        <span class="sec-kicker">The six things we do</span>
      </div>
      <h2 class="sec-title rv">Every service. One roof.<br /><em>Nothing outsourced.</em></h2>
      <div class="svc-list" style="margin-top: 56px;">
        <article class="svc rv">
          <div class="svc-idx">01</div>
          <div>
            <h3 class="svc-name">Paint Protection Film</h3>
            <p class="svc-desc">Self-healing film, precision-cut for your panels. From ₹22,000 for a front-end kit.</p>
          </div>
          <span class="svc-zone">Detailing Lab</span>
          <div class="svc-fill"></div>
        </article>
        <article class="svc rv">
          <div class="svc-idx">02</div>
          <div>
            <h3 class="svc-name">Ceramic Coating</h3>
            <p class="svc-desc">5-year ceramic with the warranty on record and a 6-monthly inspection included.</p>
          </div>
          <span class="svc-zone">Detailing Lab</span>
          <div class="svc-fill"></div>
        </article>
        <article class="svc rv">
          <div class="svc-idx">03</div>
          <div>
            <h3 class="svc-name">Detailing</h3>
            <p class="svc-desc">Paint correction under controlled light. Before and after, measured — not claimed.</p>
          </div>
          <span class="svc-zone">Detailing Lab</span>
          <div class="svc-fill"></div>
        </article>
        <article class="svc rv">
          <div class="svc-idx">04</div>
          <div>
            <h3 class="svc-name">Washing</h3>
            <p class="svc-desc">Express and premium washes with proper foam, two buckets and clean mitts. Every time.</p>
          </div>
          <span class="svc-zone">Wash Studio</span>
          <div class="svc-fill"></div>
        </article>
        <article class="svc rv">
          <div class="svc-idx">05</div>
          <div>
            <h3 class="svc-name">Garage</h3>
            <p class="svc-desc">Repairs and periodic service with a digital job card you can watch from anywhere.</p>
          </div>
          <span class="svc-zone">Performance Garage</span>
          <div class="svc-fill"></div>
        </article>
        <article class="svc rv">
          <div class="svc-idx">06</div>
          <div>
            <h3 class="svc-name">Modification</h3>
            <p class="svc-desc">Upgrades and accessories, chosen carefully and fitted right the first time.</p>
          </div>
          <span class="svc-zone">Accessory Lounge</span>
          <div class="svc-fill"></div>
        </article>
      </div>
      <div class="svc-visual">
        <figure class="rv px-img">
          <img class="tall" src="/assets/img/product-ceramic.jpg" alt="Studio-approved ceramic coating product" data-px />
        </figure>
        <div class="svc-note rv">
          <p><strong>Only products we would put on our own cars.</strong> Every coating and consumable on the shelf is the one the lab uses — batch on record, warranty in the app.</p>
        </div>
      </div>
    </section>

    <!-- APP -->
    <section class="section appsec" id="app">
      <div class="appsec-grid">
        <div>
          <div class="sec-head rv">
            <span class="sec-index">02</span>
            <span class="sec-kicker">The AutoDeck app</span>
          </div>
          <h2 class="sec-title rv">The record<br />follows <em>the car.</em></h2>
          <div class="app-feats">
            <div class="rv">
              <h3>Watch the work</h3>
              <p>Digital job cards with photos at every stage, as they happen.</p>
            </div>
            <div class="rv">
              <h3>Prove it years later</h3>
              <p>Ceramic warranty, service history and documents — on record, in your pocket.</p>
            </div>
            <div class="rv">
              <h3>Know the price first</h3>
              <p>Published prices before the car comes in. No "come and we will see".</p>
            </div>
            <div class="rv">
              <h3>Never miss a date</h3>
              <p>Maintenance calendar and reminders, kept for you.</p>
            </div>
          </div>
          <a class="btn magnetic rv" href="https://baseapp-customer.vercel.app"><span class="btn-label">Open the app</span><span class="arr">→</span></a>
          <p class="app-note rv">Runs in your browser today. App Store and Play Store soon.</p>
        </div>
        <figure class="appsec-figure rv px-img">
          <img src="/assets/img/studio-bay.jpg" alt="Inside the AutoDeck studio" data-px />
          <span class="tag">The studio · Ellisbridge</span>
        </figure>
      </div>
    </section>

    <!-- LOUNGE -->
    <section class="section lounge" id="lounge">
      <div class="lounge-grid">
        <figure class="lounge-figure rv px-img">
          <img src="/assets/img/studio-wide.jpg" alt="The AutoDeck Accessory Lounge" data-px />
        </figure>
        <div class="lounge-copy">
          <div class="sec-head rv">
            <span class="sec-index">03</span>
            <span class="sec-kicker">The Accessory Lounge</span>
          </div>
          <h2 class="sec-title rv">Wear the shield.<br /><em>Stock the shelf.</em></h2>
          <p class="rv">AutoDeck merch and car-care essentials, curated the same way we pick our coatings. On the shelf from opening day.</p>
          <ul class="lounge-items">
            <li class="rv"><span class="n">Studio Tee</span><span class="t">Opening collection</span></li>
            <li class="rv"><span class="n">Shield Cap</span><span class="t">Opening collection</span></li>
            <li class="rv"><span class="n">Care Kit</span><span class="t">Studio-approved products</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- UNDER WRAPS -->
    <section class="wraps">
      <div class="wraps-bg px-img"><img src="/assets/img/covered-car.jpg" alt="A car under wraps inside the studio" data-px /></div>
      <div class="wraps-inner">
        <div class="sec-head rv">
          <span class="sec-index">04</span>
          <span class="sec-kicker" style="color: var(--paper-dim);">Grand opening · Opening soon</span>
        </div>
        <h2 class="sec-title rv">Under wraps<br /><em>for now.</em></h2>
        <p class="wraps-note rv">Doors open soon. The date lands on <a class="inline" href="https://instagram.com/autodeck.studio" target="_blank" rel="noopener">@autodeck.studio</a> first.</p>
      </div>
    </section>

    <!-- VISIT -->
    <section class="section visit" id="visit">
      <div class="visit-banner rv px-img">
        <img src="/assets/img/storefront.jpg" alt="The AutoDeck storefront at Sunbeam Complex" data-px />
      </div>
      <div class="sec-head rv">
        <span class="sec-index">05</span>
        <span class="sec-kicker">Visit the studio</span>
      </div>
      <h2 class="sec-title rv" style="margin-bottom: 56px;">Sunbeam Complex,<br /><em>Ellisbridge.</em></h2>
      <div class="visit-grid">
        <div class="visit-block rv">
          <span class="label">Address</span>
          <p>Sunbeam Complex, Old Sharda Mandir Rd,<br />Ellisbridge, Ahmedabad, Gujarat 380006</p>
          <p style="margin-top: 14px;"><a class="inline" href="https://www.google.com/maps/search/?api=1&query=Sunbeam+Complex+Old+Sharda+Mandir+Rd+Ellisbridge+Ahmedabad" target="_blank" rel="noopener">Get directions ↗</a></p>
        </div>
        <div class="visit-block rv">
          <span class="label">Hours</span>
          <p>Mon to Sat, 10 am – 9 pm<br />Sunday, 10 am – 7 pm</p>
        </div>
        <div class="visit-block rv">
          <span class="label">Talk to us</span>
          <p><a class="inline" href="tel:+919898679711">+91 98986 79711</a><br /><a class="inline" href="https://instagram.com/autodeck.studio" target="_blank" rel="noopener">@autodeck.studio</a></p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <div class="foot-word" aria-hidden="true">AutoDeck</div>
    <div class="foot-row">
      <span>Performance Garage · Detailing Lab · Wash Studio · Accessory Lounge</span>
      <span>© 2026 AutoDeck · Made in Ahmedabad</span>
    </div>
  </footer>

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
