---
import { localBusiness } from '../data/local-business.mjs';
import body from '../data/home-v2-body.html?raw';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
// /assets/* is cached as immutable for a year, so the stylesheet URL must change when its content changes.
const cssV = createHash('sha1').update(readFileSync('public/assets/v2/home.css')).digest('hex').slice(0, 10);
const title = 'AutoDeck | Complete car care. All under one roof.';
const description = 'AutoDeck car care studio in Ahmedabad: washing, detailing, ceramic coating, paint protection film, garage and modifications. Book in the app.';
const ogImage = 'https://www.autodeck.in/assets/og.png';
const canonical = 'https://www.autodeck.in/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:site_name" content="AutoDeck" />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:url" content={canonical} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preload" href="/assets/v2/inter.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href={`/assets/v2/home.css?v=${cssV}`} />
</head>
<body>
  <div class="adsite" id="adsite-root"><div id="sc" class="adsc" set:html={body} /></div>
  <script>import '../scripts/home-v2.ts';</script>
</body>
</html>
