---
import body from '../data/home-v2-body.html?raw';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
// /assets/* is cached as immutable for a year, so the stylesheet URL must change when its content changes.
const cssV = createHash('sha1').update(readFileSync('public/assets/v2/home.css')).digest('hex').slice(0, 10);
const title = 'AutoDeck | Complete car care. All under one roof.';
const description = 'AutoDeck car care studio in Ahmedabad: washing, detailing, ceramic coating, paint protection film, garage and modifications. Book in the app.';
const ogImage = 'https://www.autodeck.in/assets/og.png';
const canonical = 'https://www.autodeck.in/';
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: 'AutoDeck',
  url: 'https://www.autodeck.in',
  image: ogImage,
  telephone: '+91 98986 79711',
  address: { '@type': 'PostalAddress', streetAddress: 'Sunbeam Complex, Old Sharda Mandir Rd, Ellisbridge', addressLocality: 'Ahmedabad', postalCode: '380006', addressCountry: 'IN' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '10:00', closes: '21:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '10:00', closes: '19:00' },
  ],
  sameAs: ['https://instagram.com/autodeck.studio'],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={canonical} />
  <meta property="og:url" content={canonical} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preload" href="/assets/v2/inter.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href={`/assets/v2/home.css?v=${cssV}`} />
</head>
<body>
  <div class="adsite" id="adsite-root"><div id="sc" class="adsc" set:html={body} /></div>
  <script>import '../scripts/home-v2.ts';</script>
</body>
</html>
