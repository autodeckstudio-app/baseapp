---
import Base from '../layouts/Base.astro';
import ProductArt from '../components/ProductArt.astro';
const services = [
 ['01','Paint protection film','Protection for the finish you want to keep.','PPF'],
 ['02','Ceramic coating','Ceramic and graphene coatings, with care for glass, wheels and interior.','Coatings'],
 ['03','Detailing','Paint, cabin and the details between.','Detailing'],
 ['04','Washing','Regular washes and deeper cleaning for the everyday drive.','Wash & Care'],
 ['05','Garage','Health checks, servicing and repairs. Inspection first where needed.','Garage'],
 ['06','Modifications','Wraps, tint and styling, discussed with the studio.','Modifications'],
];
const chapters = [
 {id:'garage',n:'01',label:'Your garage',title:'Your cars. Together.',body:'Keep your cars in one garage. See the visit in progress and book the next one.',image:'garage',alt:'Actual AutoDeck test-account Garage screen with car, progress and booking controls'},
 {id:'visit',n:'02',label:'Your visit',title:'Follow the work.',body:'See the stage of your visit, from arrival through final checks. Open Track when your car is in the studio.',image:'bookings',alt:'Actual AutoDeck test-account Bookings screen showing Final checks and Track'},
 {id:'records',n:'03',label:'Your records',title:'Keep the details.',body:'Find service history, invoices, car papers and warranties in your car\'s record.',image:'records',alt:'Actual AutoDeck test-account car record showing service history, papers and warranty sections'},
];
---
<Base title="AutoDeck · Car care, connected" description="Car care in Ahmedabad. Explore the studio, open the AutoDeck app, or browse the merchandise collection." page="home">
<section class="landing wrap">
 <div class="landing-copy"><p class="eyebrow"><i></i> AutoDeck · Ahmedabad</p><h1>Good cars.<br />Better <em>care.</em></h1><p class="intro">A studio for your car.<br />An app for everything around it.</p><div class="actions"><a class="button" href="https://app.autodeck.in">Open the app ↗</a><a class="text-link" href="#services">Explore services →</a></div></div>
 <div class="model-stage"><div id="hero-car" aria-label="Interactive covered car model. Drag to rotate."><img class="model-fallback" src="/assets/img/stock-blackcar.jpg" alt="Black car in a dark studio. Illustrative stock photograph." /></div><span class="stage-note">The next chapter starts here. <span class="drag-note">Drag to explore ↔</span></span></div>
</section>
<section class="section wrap home-services" id="services"><div class="section-head"><div><p class="eyebrow">The studio menu</p><h2>Whatever your car needs.</h2></div><p class="muted">Explore the care.<br />Book in the app.</p></div><div class="home-service-grid">{services.map(([n,t,d,label])=><a class="service-card" href="https://app.autodeck.in/catalogue"><span class="service-number">{n}</span><div><h3>{t}</h3><p>{d}</p></div><span class="service-arrow" aria-hidden="true">↗</span><span class="sr-only">Explore {label} in the app</span></a>)}</div><div class="pickup-note"><p>Pickup and drop available. Request it with your visit; the studio confirms the time.</p><a class="text-link" href="https://app.autodeck.in">Explore the app ↗</a></div></section>
<section class="app-story" id="app" aria-labelledby="app-heading"><div class="wrap app-story-heading"><p class="eyebrow">The AutoDeck app</p><h2 id="app-heading">Your car care.<br /><em>One place.</em></h2><p class="intro">A look inside the app, from your garage to your next visit.</p></div><div class="wrap app-story-grid"><div class="app-device-stage"><div class="device-glow" aria-hidden="true"></div><div class="phone-shell"><div class="phone-camera" aria-hidden="true"></div>{chapters.map((c,i)=><img class:list={['app-screen',{'is-active':i===0}]} data-screen={c.id} src={`/assets/app-preview/${c.image}.webp`} width="390" height="844" alt={c.alt} loading="lazy" />)}</div><p class="screen-caption">Actual app screens · TEST account</p><div class="screen-progress" aria-hidden="true">{chapters.map((c,i)=><i class:list={{'is-active':i===0}} data-dot={c.id}></i>)}</div><div class="app-stage-copy"><p class="chapter-index" data-stage-index>01 / Your garage</p><h3 data-stage-title>Your cars. Together.</h3><p data-stage-body>Keep your cars in one garage. See the visit in progress and book the next one.</p><a class="text-link" href="https://app.autodeck.in">Open the app ↗</a></div></div><div class="app-chapters">{chapters.map((c,i)=><article class:list={['app-chapter',{'is-active':i===0}]} id={`app-${c.id}`} data-chapter={c.id}><p class="chapter-index">{c.n} / {c.label}</p><h3>{c.title}</h3><p>{c.body}</p><a class="text-link" href="https://app.autodeck.in">Open the app ↗</a><img class="static-app-screen" src={`/assets/app-preview/${c.image}.webp`} width="390" height="844" alt={c.alt} loading="lazy" /></article>)}</div></div><div class="wrap"><div class="app-install glass"><div><p class="eyebrow">On your phone</p><h3>Open AutoDeck.</h3><p>Use the web app now. On iPhone, open it in Safari, tap Share, then Add to Home Screen. On Android, use your browser's Install app or Add to Home screen option.</p></div><a class="button" href="https://app.autodeck.in">Open the app ↗</a></div></div></section>
<section class="section wrap" id="studio"><div class="section-head"><div><p class="eyebrow">Inside AutoDeck</p><h2>A space built around cars.</h2></div><p class="muted">A look at the studio design.<br />Concept renders from our archive.</p></div><div class="studio-strip"><figure class="reveal"><img src="/assets/img/merch-display.jpg" alt="Studio lighting concept render from AutoDeck's design archive" loading="lazy"/><figcaption>Light, considered.</figcaption></figure><figure class="reveal"><img src="/assets/img/wash-bay.jpg" alt="Accessory wall and studio concept render from AutoDeck's design archive" loading="lazy"/><figcaption>Every corner has a purpose.</figcaption></figure><figure class="reveal"><img src="/assets/img/lounge-wall.jpg" alt="Studio with orange structural accents, concept render" loading="lazy"/><figcaption>The AutoDeck accent.</figcaption></figure></div></section>
<section class="section wrap"><a href="/shop" class="store-teaser reveal"><div><p class="eyebrow">AutoDeck collection</p><h2>Off the road.<br />Still AutoDeck.</h2><span class="text-link">Explore the store →</span></div><div class="culture-art" aria-hidden="true"><ProductArt kind="tee"/><ProductArt kind="key"/><ProductArt kind="cap"/></div></a></section>
<section class="section wrap" id="visit"><div class="section-head"><div><p class="eyebrow">Find us</p><h2>See you at AutoDeck.</h2></div><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Sunbeam+Complex+Old+Sharda+Mandir+Rd+Ellisbridge+Ahmedabad" target="_blank" rel="noopener">Get directions ↗</a></div></section><section class="wrap visit-layout"><div class="visit-info"><article><small>Address</small><p>Sunbeam Complex, Old Sharda Mandir Rd,<br />Ellisbridge, Ahmedabad 380006</p></article><article><small>Studio hours</small><p>Monday to Saturday · 10 am to 9 pm<br />Sunday · 10 am to 7 pm</p></article><article><small>Talk to the studio</small><p><a href="tel:+919898679711">+91 98986 79711</a></p><a class="text-link" href="https://instagram.com/autodeck.studio" target="_blank" rel="noopener">@autodeck.studio ↗</a></article></div></section>
<noscript><style>.app-device-stage{display:none}.app-story-grid{display:block}.app-chapter{min-height:0;opacity:1;padding-block:30px;border-top:1px solid #ffffff25}.static-app-screen{display:block;width:220px;height:auto;margin:24px auto 0;border:4px solid #303235;border-radius:22px}</style></noscript></Base>
