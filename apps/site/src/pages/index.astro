---
import Base from '../layouts/Base.astro';
const chapters = [
  { n: '01', t: 'Protect', l: 'Self-healing film, cut to your car.', k: 'Paint Protection Film', from: 'from ₹65,000', img: '/assets/img/covered-car.jpg' },
  { n: '02', t: 'Perfect', l: 'Paint corrected under studio light.', k: 'Detailing and Ceramic', from: 'from ₹3,500', img: '/assets/img/car-lights.jpg' },
  { n: '03', t: 'Keep clean', l: 'The wash it should always have been.', k: 'Wash Studio', from: 'from ₹500', img: '/assets/img/product-ceramic.jpg' },
  { n: '04', t: 'Keep running', l: 'Repairs and fitting, with a Sample update.', k: 'Performance Garage', from: 'quoted per car', img: '/assets/img/studio-bay.jpg' },
];
const steps = [['09:12', 'Vehicle received'], ['09:20', 'Photos taken at the bay'], ['11:05', 'Paint correction in progress'], ['04:40', 'Coating cured, final check'], ['06:15', 'Ready for handover']];
const brands = ['3M', 'Garware', 'LLumar', 'XPEL', 'Fireball', 'Kovalent'];
---
<Base
  title="AutoDeck · Complete car care. All under one roof."
  description="Detailing, paint protection, ceramic, washing, garage and modification at one address in Ellisbridge, Ahmedabad, with your car's whole record in the app you hold. Nothing outsourced. Grand opening Friday 16 October 2026."
  page="home"
>
  <section class="hero2" data-bg="0">
    <div class="wrap">
      <p class="eyebrow">Ellisbridge · Ahmedabad</p>
      <h1>One roof.<br /><em>Every craft.</em></h1>
      <p class="lede">Nothing outsourced. Your car, and its whole story, in one team's hands.</p>
      <div class="actions">
        <a class="btn" href="https://app.autodeck.in">Book a slot <span aria-hidden="true">→</span></a>
        <a class="btn ghost" href="/services">See every service</a>
      </div>
      <div class="live" aria-live="off"><span class="dot"></span><div><small>Sample update</small><b id="live-line">Vehicle received</b><em id="live-time">09:12 am</em></div></div>
      <a class="scue" href="#story" aria-label="Scroll"><i></i></a>
    </div>
  </section>

  <section class="pin" id="story" data-bg="1" data-pin>
    <div class="pin-in">
      <div class="wrap pin-grid">
        <div class="pin-copy">
          <div class="bignum" data-num>01</div>
          {chapters.map((c, i) => (
            <div class={`chap${i === 0 ? ' on' : ''}`} data-chap>
              <p class="eyebrow">{c.k}</p>
              <h2>{c.t}</h2>
              <p class="lede">{c.l}</p>
              <span class="from">{c.from}</span>
            </div>
          ))}
          <div class="rail"><i data-rail></i></div>
        </div>
        <div class="pin-vis" data-vis>
          {chapters.map((c, i) => (<figure class={`shot${i === 0 ? ' on' : ''}`} data-shot style={`background-image:url(${c.img})`}></figure>))}
          <div class="glass tag"><small>AutoDeck</small><b data-tag>Paint Protection Film</b></div>
        </div>
      </div>
    </div>
  </section>

  <section class="record" data-bg="2">
    <div class="wrap rec-grid">
      <div>
        <p class="eyebrow rv">The record follows the car</p>
        <h2 class="big rv">Watch it happen.<br /><em>Prove it later.</em></h2>
        <p class="lede rv">Photos at every stage. Warranty and papers on file, ready the day you sell.</p>
        <div class="actions rv"><a class="btn" href="https://app.autodeck.in">Open the app</a><a class="btn ghost" href="/app">How it works</a></div>
      </div>
      <ol class="tline glass" data-tline>
        {steps.map(([t, s]) => (<li><i></i><div><b>{s}</b><span>{t}</span></div></li>))}
      </ol>
    </div>
  </section>

  <section class="nums" data-bg="1">
    <div class="wrap">
      <div class="rv"><b data-count="59">0</b><span>services, priced and published</span></div>
      <div class="rv"><b data-count="6">0</b><span>crafts under one roof</span></div>
      <div class="rv"><b data-count="0">0</b><span>jobs outsourced. Ever.</span></div>
    </div>
  </section>

  <section class="brands" data-bg="3" aria-label="Brands we fit">
    <p class="eyebrow">Only products we would put on our own cars</p>
    <div class="marq"><div>{[...brands, ...brands, ...brands].map((b) => (<span class="glass">{b}</span>))}</div></div>
  </section>

  <section class="rooms2" data-bg="3">
    <div class="wrap">
      <p class="eyebrow rv">Four zones, one address</p>
      <div class="r4">
        <a class="glass rv" href="/services" style="background-image:linear-gradient(0deg,rgba(20,20,18,.75),rgba(20,20,18,.1)),url(/assets/img/studio-bay.jpg)"><b>Performance Garage</b><span>Repairs, service, fitting</span></a>
        <a class="glass rv" href="/services" style="background-image:linear-gradient(0deg,rgba(20,20,18,.75),rgba(20,20,18,.1)),url(/assets/img/car-lights.jpg)"><b>Detailing Lab</b><span>Film, ceramic, correction</span></a>
        <a class="glass rv" href="/services" style="background-image:linear-gradient(0deg,rgba(20,20,18,.75),rgba(20,20,18,.1)),url(/assets/img/product-ceramic.jpg)"><b>Wash Studio</b><span>The careful wash</span></a>
        <a class="glass rv" href="/lounge" style="background-image:linear-gradient(0deg,rgba(20,20,18,.75),rgba(20,20,18,.1)),url(/assets/img/storefront.jpg)"><b>Accessory Lounge</b><span>Merch and care</span></a>
      </div>
    </div>
  </section>

  <section class="s cta" data-bg="0">
    <div class="wrap">
      <div class="cta-box rv">
        <div>
          <h2>Book your first slot.</h2>
          <p>Pick a service, see the price, choose a time. Doors open Friday 16 October, 10 am.</p>
          <div class="actions" style="margin-top:28px"><a class="btn" href="https://app.autodeck.in">Book a slot <span aria-hidden="true">→</span></a><a class="btn ghost" href="tel:+919898679711">Call the studio</a></div>
        </div>
        <div class="facts">
          <div><b>Doors open in</b>
            <span class="count" id="countdown" data-target="2026-10-16T10:00:00+05:30" role="status"><span><b data-cd="d">00</b><i>days</i></span><span><b data-cd="h">00</b><i>hrs</i></span><span><b data-cd="m">00</b><i>min</i></span><span style="display:none"><b data-cd="s">00</b></span></span>
          </div>
          <div><b>Find us</b>Sunbeam Complex, Old Sharda Mandir Rd, Ellisbridge</div>
          <div><b>Hours</b>Mon to Sat 10 am to 9 pm · Sun 10 am to 7 pm</div>
        </div>
      </div>
    </div>
  </section>
</Base>
