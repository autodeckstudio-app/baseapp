---
import Base from '../layouts/Base.astro';
import merch from '../data/merch.json';
const chapters = [
  { n: '01', t: 'Protect', l: 'Self-healing film, cut to your car.', k: 'Paint Protection Film', img: '/assets/img/covered-car.jpg' },
  { n: '02', t: 'Perfect', l: 'Paint corrected under studio light.', k: 'Detailing and Ceramic', img: '/assets/img/car-lights.jpg' },
  { n: '03', t: 'Keep clean', l: 'The wash it should always have been.', k: 'Wash Studio', img: '/assets/img/product-ceramic.jpg' },
  { n: '04', t: 'Keep running', l: 'Repairs and fitting, with updates on your car from anywhere.', k: 'Performance Garage', img: '/assets/img/studio-bay.jpg' },
];
const steps = [['09:12', 'Vehicle received'], ['09:20', 'Photos taken at the bay'], ['11:05', 'Paint correction in progress'], ['04:40', 'Coating cured, final check'], ['06:15', 'Ready for handover']];
const film = [
  { img: '/assets/img/studio-wide.jpg', t: 'The floor, before the day starts', h: '/gallery' },
  { img: '/assets/img/covered-car.jpg', t: 'Under cover until handover', h: '/gallery' },
  { img: '/assets/img/car-lights.jpg', t: 'Corrected under studio light', h: '/gallery' },
  { img: '/assets/img/product-ceramic.jpg', t: 'Ceramic, cured and checked', h: '/gallery' },
  { img: '/assets/img/studio-bay.jpg', t: 'The bay, mid-job', h: '/gallery' },
  { img: '/assets/img/studio-orange.jpg', t: 'One address in Ahmedabad', h: '/visit' },
];
const brands = ['3M', 'Garware', 'LLumar', 'XPEL', 'Fireball', 'Kovalent'];
---
<Base
  title="AutoDeck · Complete car care. All under one roof."
  description="Detailing, paint protection, ceramic, washing, garage and modification at one address in Ahmedabad, with your car's whole record in the app you hold. Nothing outsourced."
  page="home"
>
  <div class="intro-veil" data-intro aria-hidden="true"><b>AutoDeck</b><i></i></div>
  <section class="hero2" data-bg="0">
    <div class="hero-car" data-hero-car aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">Ahmedabad</p>
      <h1>One roof.<br /><em>Every craft.</em></h1>
      <p class="lede">Nothing outsourced. Your car, and its whole story, in one team's hands.</p>
      <div class="actions">
        <a class="btn" href="https://app.autodeck.in">Book a slot <span aria-hidden="true">→</span></a>
        <a class="btn ghost" href="/services">See what we do</a>
      </div>
      <div class="live" aria-live="off"><span class="dot"></span><div><small>Sample update</small><b id="live-line">Vehicle received</b><em id="live-time">09:12 am</em></div></div>
      <a class="scue" href="#story" aria-label="Scroll"><i></i></a>
    </div>
  </section>

  <section class="pin" id="story" data-bg="1" data-pin>
    <div class="pin-in">
      <div class="wrap pin-grid">
        <div class="pin-copy">
          <div class="bignum" data-num>01</div>
          {chapters.map((c, i) => (
            <div class={`chap${i === 0 ? ' on' : ''}`} data-chap>
              <p class="eyebrow">{c.k}</p>
              <h2>{c.t}</h2>
              <p class="lede">{c.l}</p>
              <a class="from" href="https://app.autodeck.in">Prices in the app <span aria-hidden="true">→</span></a>
            </div>
          ))}
          <div class="rail"><i data-rail></i></div>
        </div>
        <div class="pin-vis" data-vis>
          {chapters.map((c, i) => (<figure class={`shot${i === 0 ? ' on' : ''}`} data-shot style={`background-image:url(${c.img})`}></figure>))}
          <div class="glass tag"><small>AutoDeck</small><b data-tag>Paint Protection Film</b></div>
        </div>
      </div>
      <div class="road" aria-hidden="true">
        <div class="road-line"><i></i></div>
        {chapters.map((c, i) => (<span class="stn" data-stn style={`left:${((i + 0.5) / chapters.length) * 100}%`}><b></b><small>{c.k}</small></span>))}
        <div class="car" data-car><svg viewBox="0 0 240 72" fill="none"><defs><linearGradient id="cb" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F4F2ED"/><stop offset="1" stop-color="#B9B6AE"/></linearGradient></defs><path d="M6 50c0-6 6-9 18-11l34-6c12-11 28-19 48-20h40c14 1 26 9 40 18l28 5c12 2 18 7 18 14v6H6v-6Z" fill="url(#cb)"/><path d="M72 32c10-10 22-14 36-14h34c10 1 18 7 28 14H72Z" fill="#161615"/><path d="M107 18l-3 14M148 19l4 13" stroke="#B9B6AE" stroke-width="2"/><path d="M20 41h196" stroke="#EC8638" stroke-width="1.5" opacity=".9"/><rect x="226" y="40" width="9" height="4" rx="2" fill="#FFF3DC"/><rect x="5" y="40" width="8" height="4" rx="2" fill="#EC8638"/><circle cx="62" cy="54" r="17" fill="#0c0c0b"/><circle cx="178" cy="54" r="17" fill="#0c0c0b"/><g class="wh"><circle cx="62" cy="54" r="13" fill="#1d1d1b" stroke="#2e2e2c" stroke-width="2"/><circle cx="62" cy="54" r="8" fill="#9a978f"/><path d="M62 46v16M54 54h16M56 48l12 12M68 48L56 60" stroke="#EC8638" stroke-width="1.6"/></g><g class="wh"><circle cx="178" cy="54" r="13" fill="#1d1d1b" stroke="#2e2e2c" stroke-width="2"/><circle cx="178" cy="54" r="8" fill="#9a978f"/><path d="M178 46v16M170 54h16M172 48l12 12M184 48l-12 12" stroke="#EC8638" stroke-width="1.6"/></g></svg></div>
      </div>
    </div>
  </section>

  <section class="record" data-bg="2">
    <div class="wrap rec-grid">
      <div>
        <p class="eyebrow rv">The record follows the car</p>
        <h2 class="big rv">Watch it happen.<br /><em>Prove it later.</em></h2>
        <p class="lede rv">Photos at every stage. Warranty and papers on file, ready the day you sell.</p>
        <div class="actions rv"><a class="btn" href="https://app.autodeck.in">Open the app</a><a class="btn ghost" href="/app">How it works</a></div>
      </div>
      <ol class="tline glass" data-tline>
        {steps.map(([t, s]) => (<li><i></i><div><b>{s}</b><span>{t}</span></div></li>))}
      </ol>
    </div>
  </section>

  <section class="nums" data-bg="1">
    <div class="wrap">
      <div class="rv"><b data-count="59">0</b><span>services, priced in the app</span></div>
      <div class="rv"><b data-count="6">0</b><span>crafts under one roof</span></div>
      <div class="rv"><b data-count="0">0</b><span>jobs outsourced. Ever.</span></div>
    </div>
  </section>

  <section class="film" data-bg="1" data-film>
    <div class="film-pin">
      <div class="wrap film-head">
        <p class="eyebrow rv">Inside the studio</p>
        <h2 class="big rv">One slow pass across the floor.</h2>
      </div>
      <div class="film-track" data-film-track>
        {film.map((f) => (
          <a class="film-card" href={f.h} style={`background-image:linear-gradient(0deg,rgba(20,20,18,.72),rgba(20,20,18,.04)),url(${f.img})`}><span class="glass">{f.t}</span></a>
        ))}
      </div>
      <div class="film-prog" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="brands" data-bg="3" aria-label="Brands we fit">
    <p class="eyebrow">Only products we would put on our own cars</p>
    <div class="marq"><div>{[...brands, ...brands, ...brands].map((b) => (<span class="glass">{b}</span>))}</div></div>
  </section>

  <section class="rooms2" data-bg="3">
    <div class="wrap">
      <p class="eyebrow rv">Four zones, one address</p>
      <div class="r4">
        <a class="glass rv" href="/services" style="background-image:linear-gradient(0deg,rgba(20,20,18,.75),rgba(20,20,18,.1)),url(/assets/img/studio-bay.jpg)"><b>Performance Garage</b><span>Repairs, service, fitting</span></a>
        <a class="glass rv" href="/services" style="background-image:linear-gradient(0deg,rgba(20,20,18,.75),rgba(20,20,18,.1)),url(/assets/img/car-lights.jpg)"><b>Detailing Lab</b><span>Film, ceramic, correction</span></a>
        <a class="glass rv" href="/services" style="background-image:linear-gradient(0deg,rgba(20,20,18,.75),rgba(20,20,18,.1)),url(/assets/img/product-ceramic.jpg)"><b>Wash Studio</b><span>The careful wash</span></a>
        <a class="glass rv" href="/lounge" style="background-image:linear-gradient(0deg,rgba(20,20,18,.75),rgba(20,20,18,.1)),url(/assets/img/storefront.jpg)"><b>Accessory Lounge</b><span>Merch and care</span></a>
      </div>
    </div>
  </section>

  <section class="s merch" data-bg="3">
    <div class="wrap">
      <p class="eyebrow rv">The Accessory Lounge</p>
      <h2 class="big rv">Wear the shield. <em>Stock the shelf.</em></h2>
      <div class="shop" style="margin-top:34px">
        {merch.map((m) => (
          <a class="item glass rv merch-card" href="/lounge">
            <div class="ph">{m.image ? <img src={m.image} alt={m.name} loading="lazy" /> : <span>Photo soon</span>}</div>
            <div class="tx"><h3>{m.name}</h3><p>{m.blurb}</p></div>
          </a>
        ))}
      </div>
      <p class="fine rv" style="margin-top:22px">First drops on <a href="https://instagram.com/autodeck.studio" target="_blank" rel="noopener">@autodeck.studio</a>. The full shelf is at the studio.</p>
    </div>
  </section>

  <section class="s cta" data-bg="0">
    <div class="wrap">
      <div class="cta-box rv">
        <div>
          <h2>Book your first slot.</h2>
          <p>Pick a service, see your price in the app, choose a time.</p>
          <div class="actions" style="margin-top:28px"><a class="btn" href="https://app.autodeck.in">Book a slot <span aria-hidden="true">→</span></a><a class="btn ghost" href="tel:+919898679711">Call the studio</a></div>
        </div>
        <div class="facts">
          <div><b>Find us</b>Sunbeam Complex, Old Sharda Mandir Rd, Ellisbridge</div>
          <div><b>Hours</b>Mon to Sat 10 am to 9 pm · Sun 10 am to 7 pm</div>
        </div>
      </div>
    </div>
  </section>
</Base>
