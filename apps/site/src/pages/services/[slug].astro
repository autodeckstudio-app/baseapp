---
import Redesign from '../../layouts/Redesign.astro';
import services from '../../data/services.json';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}))}
const {service}=Astro.props;
const appCategoryLinks:Record<string,string>={
 'paint-protection-film':'https://app.autodeck.in/catalogue?cat=ppf',
 'ceramic-coating':'https://app.autodeck.in/catalogue?cat=coatings&p=ceramic',
 'detailing':'https://app.autodeck.in/catalogue?cat=wash',
 'washing':'https://app.autodeck.in/catalogue?cat=wash',
 'garage':'https://app.autodeck.in/catalogue?cat=garage',
 'modifications':'https://app.autodeck.in/catalogue?cat=mods'
};
---
<Redesign title={`${service.title} · AutoDeck`} description={service.description}>
<div class="page-intro service-intro"><a class="back" href="/services">All seven services</a><p class="eyebrow">AUTODECK / {service.title}</p><h1>{service.headline??service.title}</h1><p>{service.description}</p></div>
<section class="service-detail">
{service.zones?(
<div><p class="eyebrow">{service.markers?'CHECK AREAS, EXPLAINED SIMPLY':(service.zonesEyebrow??'COVERAGE, EXPLAINED SIMPLY')}</p><div class="service-rover" data-rover-zones {...{...(service.markers?{'data-rover-markers':true}:{}),...(service.layerBuild?{'data-rover-layerbuild':true}:{})}} tabindex="0" role="group" aria-label={service.markers?'Illustrative Range Rover Sport 2018 model with typical first-check area markers. Drag left or right, or use arrow keys, to rotate.':'Illustrative Range Rover Sport 2018 model with coverage highlighting. Drag left or right, or use arrow keys, to rotate.'}><img alt="" class="rover-poster" src={service.poster}/><div aria-hidden="true" class="rover-canvas"></div></div><div class="zone-chips">{service.choices.map(([title,,level]:[string,string,number?],i:number)=><button data-zone-chip data-zone-level={level??[1,2,3][i]??3} aria-pressed={i===0?'true':'false'}>{title}</button>)}</div><p class="fine">{service.zonesNote??'Coverage shown is illustrative, not a panel map. Windows and trim are not covered.'}</p></div>
):(
<div><img class="service-detail-image" src={service.image} alt={`${service.title} illustration`} /><p class="fine">Illustrative image, not a customer result.</p></div>
)}
<div class="service-decision glass"><p class="eyebrow">FIND YOUR STARTING POINT</p><h2>{service.heading}</h2><p>{service.intro}</p><p class="choice-hint">Tap a focus to see the scope.</p><div class="service-options visual-options">{service.choices.map(([title,copy]:[string,string],i:number)=><details open={i===0}><summary><span class="scope-art" aria-hidden="true"><i></i><b>{String(i+1).padStart(2,'0')}</b></span><span><h3>{title}</h3><small>{title.includes('Enquiry')||service.enquiry?'Discuss & quote':'Explore scope'}</small></span><span class="scope-toggle" aria-hidden="true">+</span></summary><p>{copy}</p></details>)}</div>
{service.enquiry?(
<div class="service-enquiry-note"><span>Enquiry only</span><p>Not in the booking catalogue yet - call the studio to discuss your car.</p></div>
<a class="solid" href="tel:+919898679711">Call the studio</a>
):(
<div class="decision-row"><span>Ready to book?</span><p>Open the app and choose {service.appChoice} for your car.</p></div><button class="solid" data-book data-service={service.title} data-app-category-link={appCategoryLinks[service.slug]}>Book {service.title.toLowerCase()}</button><p class="fine">Opens a handoff, not a confirmed appointment.</p>
)}
<details class="service-checklist"><summary>What to confirm with the studio <span aria-hidden="true">+</span></summary><p>{service.question}</p></details>
{!service.enquiry&&<a class="outline" href="tel:+919898679711">Call the studio</a>}
<a class="service-related" href={`/services/${service.related}`}>{service.relatedLabel}</a></div></section>
<section class="service-next"><p class="eyebrow">KEEP EXPLORING</p><h2>All under one roof</h2><div class="service-links">{services.filter(s=>s.slug!==service.slug).map(s=><a href={`/services/${s.slug}`}>{s.title} <span aria-hidden="true">&rarr;</span></a>)}</div></section>
</Redesign>
