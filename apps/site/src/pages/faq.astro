---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
const faqs = [
  { q: 'Where is AutoDeck?', a: 'Sunbeam Complex, Old Sharda Mandir Rd, Ellisbridge, Ahmedabad 380006. ', link: { href: 'https://www.google.com/maps/search/?api=1&query=Sunbeam+Complex+Old+Sharda+Mandir+Rd+Ellisbridge+Ahmedabad', text: 'Get directions' } },
  { q: 'When are you open?', a: 'Monday to Saturday, 10 am to 9 pm. Sunday, 10 am to 7 pm.' },
  { q: 'How do I book a service?', a: 'In the AutoDeck app: pick a service, pick your car, pick a slot. Slots run inside studio hours.', link: { href: '/app', text: 'About the app' } },
  { q: 'Can I reschedule or cancel?', a: 'You can reschedule up to two times, at least 24 hours before the slot. For washes and other short jobs, cancelling is free until 4 hours before the start; after that, Rs 100 applies. For bigger services (coatings, paint protection film, garage repairs and inspections, mods and wraps), cancelling is free until 24 hours before the start; after that, 20% of the booking total applies. Refunds go to your original payment method. Refund timing depends on your bank or payment provider, and any cancellation fee is taken from the refund.' },
  { q: 'Do you offer pickup and drop?', a: 'Yes, for every service. It costs Rs 100 for each leg under 3 km from the studio, and Rs 150 for each leg from 3 km. Club plans include free pickups.' },
  { q: 'How do payments work?', a: 'Pay at the studio or online in the app. Online payments are processed by Razorpay, and you get an invoice for every completed job.' },
  { q: 'What is AutoDeck Club?', a: 'Club plans last 30 days and bundle a set number of washes and pickups for one price. They belong to your account, so you can use them for any car in your garage.', link: { href: '/app', text: 'See Club in the app' } },
  { q: 'Which products do you use?', a: 'Coatings from Kovalent, Fireball and 3M, and films from XPEL, Garware, LLumar and 3M. The exact product for your car is confirmed when you book.' },
  { q: 'Is my car covered while it is with you?', a: 'Some services carry a warranty from AutoDeck; the terms sit on the warranty record under your car in Garage. If our work damages your car, we repair it or compensate you. Please take valuables out before drop-off.' },
  { q: 'Do you buy and sell cars?', a: 'Yes. Cars are listed in the app and the studio reviews every listing before other customers see it. Number plates, owner details and prices stay hidden until you sign in.', link: { href: '/cars', text: 'See the showcase' } },
  { q: 'How do I reach the studio?', a: 'Call or WhatsApp +91 98986 79711, or write to autodeckstudio@gmail.com.', phone: true },
];
---
<Base title="Questions · AutoDeck" description="Answers about booking, hours, pickup and drop, Club plans and car care at AutoDeck, Ahmedabad." page="faq">
  <section class="phero"><div class="wrap">
    <p class="eyebrow">Good to know</p>
    <h1>Questions.</h1>
    <p class="lede">The essentials about visiting, booking and caring for your car at AutoDeck. For anything else, call or WhatsApp <a class="link" href="tel:+919898679711">+91 98986 79711</a>.</p>
  </div></section>
  <section class="s" style="padding-top:34px"><div class="wrap faq-list">
    {faqs.map((f) => (
      <details class="faq-item">
        <summary><span>{f.q}</span><Arrow dir="s" /></summary>
        <div class="faq-a"><p>{f.a}{f.phone && <> <a class="link" href="tel:+919898679711">Call</a> · <a class="link" href="mailto:autodeckstudio@gmail.com">Email</a></>}{f.link && <> <a class="text-link" href={f.link.href} target={f.link.href.startsWith('http') ? '_blank' : undefined} rel={f.link.href.startsWith('http') ? 'noopener' : undefined}>{f.link.text} <Arrow /></a></>}</p></div>
      </details>
    ))}
  </div></section>
  <style>
    .faq-list{max-width:760px;display:grid}
    .faq-item{border-top:1px solid var(--line)}
    .faq-item:last-child{border-bottom:1px solid var(--line)}
    .faq-item summary{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 4px;cursor:pointer;list-style:none;font-size:17px;font-weight:600;letter-spacing:-.01em}
    .faq-item summary::marker{content:none;display:none}.faq-item summary::-webkit-details-marker{display:none}
    .faq-item summary svg{flex-shrink:0;transition:transform .25s;color:var(--orange)}
    .faq-item[open] summary svg{transform:rotate(180deg)}
    .faq-a{padding:0 4px 24px}
    .faq-a p{font-size:14px;line-height:1.75;color:var(--muted);max-width:44em}
    .faq-a .text-link{margin-top:12px;display:inline-flex}
    @media(max-width:600px){.faq-item summary{font-size:15px;padding:18px 2px}.faq-a p{font-size:13px}}
  </style>
</Base>
