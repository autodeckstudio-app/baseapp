---
import Base from '../layouts/Base.astro';
---
<Base
  title="Cars for sale · AutoDeck"
  description="Cars listed through AutoDeck, checked by the studio. Browse freely, sign in to request a price."
  page="cars"
>
  <section class="phero"><div class="wrap">
    <p class="eyebrow">Cars for sale</p>
    <h1>Find your <em>next car.</em></h1>
    <p class="lede">Checked by the studio. Real photos, plain facts. Browse freely. Prices are shared once you sign in and ask.</p>
  </div></section>
  <section class="sec"><div class="wrap">
    <div id="cars" class="cargrid" aria-live="polite"><p class="carnote">Loading cars...</p></div>
  </div></section>
  <script is:inline>
    (function () {
      var box = document.getElementById('cars');
      var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); };
      fetch('https://asia-south1-autodeck-studio.cloudfunctions.net/listPublicCarListings', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data: {} })
      }).then(function (r) { return r.json(); }).then(function (j) {
        var list = (j.result && j.result.listings) || [];
        if (!list.length) { box.innerHTML = '<p class="carnote">No cars listed right now. New cars appear here as soon as the studio lists them.</p>'; return; }
        box.innerHTML = list.map(function (l) {
          var img = l.photoUrls && l.photoUrls[0] ? '<img src="' + esc(l.photoUrls[0]) + '" alt="' + esc(l.year + ' ' + l.make + ' ' + l.model) + '" loading="lazy" />' : '';
          return '<a class="carcard glass" href="https://app.autodeck.in/cars/' + esc(l.id) + '"><div class="carimg">' + img +
            (l.status === 'reserved' ? '<span class="cartag">Reserved</span>' : '') + '</div><div class="carbody"><div><h3>' + esc(l.make + ' ' + l.model) + '</h3><p>' + esc(l.year) + (l.variant ? ' \u00B7 ' + esc(l.variant) : '') + '</p></div><span class="carprice">Price on request</span></div><p class="carmeta">' +
            esc((l.kmDriven || 0).toLocaleString('en-IN')) + ' km \u00B7 ' + esc(l.fuel) + ' \u00B7 ' + esc(l.gearbox) + ' \u00B7 ' + esc(l.area) + '</p><span class="carcta">Sign in to request the price \u203A</span></a>';
        }).join('');
      }).catch(function () { box.innerHTML = '<p class="carnote">Cars could not load. Check your connection and refresh.</p>'; });
    })();
  </script>
</Base>
