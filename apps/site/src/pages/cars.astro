---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import '../styles/cars.css';
import rawCars from '../data/cars.json';
import { validatePublicCars } from '../data/public-cars.mjs';
const cars = validatePublicCars(rawCars);
const appUrl = 'https://app.autodeck.in';
---
<Base title="Cars · AutoDeck" description="Buy and sell cars with AutoDeck. Explore our held-car showcase, with price enquiries and further details in the app." page="cars">
<section class="cars-opening wrap"><div><p class="eyebrow"><i></i> AutoDeck cars</p><h1>Your next drive.<br /><em>Your next chapter.</em></h1><p class="intro">We buy and sell cars.<br />Start your next move with AutoDeck.</p><a class="text-link" href="#held-cars">Explore the showcase <Arrow dir="s" /></a></div><div class="cars-paths"><article><span>01 / Buy</span><h2>Find your next car.</h2><p>Explore the cars we hold, then continue in the app for price enquiries and further details.</p><a href={appUrl} class="text-link">Sign in on the app <Arrow /></a></article><article><span>02 / Sell</span><h2>Make room for what's next.</h2><p>Tell us about your car in the app.</p><a href={appUrl} class="text-link">Start in the app <Arrow /></a></article></div></section>
<section id="held-cars" class="held-cars wrap" aria-labelledby="held-heading"><div class="held-head"><div><p class="eyebrow">The AutoDeck showcase</p><h2 id="held-heading">Cars we hold.</h2></div><p>Public showcase.<br />Private details stay in the app.</p></div>
{cars.length ? <div class="held-grid">{cars.map(car=><article class="held-card"><div class="held-photo"><img src={car.photo} alt={car.photoAlt} loading="lazy"/></div><div class="held-copy"><p class="eyebrow">{car.year || 'AutoDeck cars'}</p><h3>{car.make} {car.model}{car.variant ? ` ${car.variant}` : ''}</h3><ul aria-label="Public car specifications">{[car.kilometres !== undefined ? `${car.kilometres.toLocaleString('en-IN')} km` : null,car.fuel,car.transmission,car.bodyStyle].filter(Boolean).map(spec=><li>{spec}</li>)}</ul><a class="text-link" href={appUrl}>Sign in on the app for price and details <Arrow /></a><p class="held-note">Price requests continue in the app.</p></div></article>)}</div> : <div class="held-empty"><span aria-hidden="true"><Arrow /></span><div><h3>Inventory updates to follow.</h3><p>Our held-car showcase is being prepared. No cars are listed on this page yet.</p><a href={appUrl} class="text-link">Sign in on the app for price enquiries and details <Arrow /></a></div></div>}
<div id="live-cars" class="held-grid" data-endpoint="https://asia-south1-autodeck-studio.cloudfunctions.net/listPublicCarListings" hidden></div>
<div class="cars-privacy"><p>No number plates, owner information or prices are published in this showcase.</p><p>Continue in the app to sign in and enquire. This page does not check your app sign-in.</p></div>
</section>
<script is:inline>
(function(){
  var box=document.getElementById('live-cars'); if(!box) return;
  var empty=document.querySelector('.held-empty');
  var cap=function(t){t=String(t||'');return t.charAt(0).toUpperCase()+t.slice(1);};
  var ok=function(v){return typeof v==='string'&&v.length>0&&v.length<=80;};
  fetch(box.dataset.endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({data:{}})})
    .then(function(r){return r.ok?r.json():Promise.reject();})
    .then(function(j){
      var list=(j&&j.result&&j.result.listings)||[]; if(!list.length) return;
      list.forEach(function(c){
        if(!ok(c.make)||!ok(c.model)) return;
        var a=document.createElement('article'); a.className='held-card';
        var d=document.createElement('div'); d.className='held-copy';
        var e=document.createElement('p'); e.className='eyebrow'; e.textContent=(c.status==='reserved'?'Reserved':(c.year||'AutoDeck cars'));
        var h=document.createElement('h3'); h.textContent=[c.make,c.model,ok(c.variant)?c.variant:''].filter(Boolean).join(' ');
        var ul=document.createElement('ul'); ul.setAttribute('aria-label','Public car specifications');
        [typeof c.kmDriven==='number'?c.kmDriven.toLocaleString('en-IN')+' km':null,ok(c.fuel)?cap(c.fuel):null,ok(c.gearbox)?cap(c.gearbox):null,ok(c.bodyType)?cap(c.bodyType):null].filter(Boolean).forEach(function(t){var li=document.createElement('li');li.textContent=t;ul.appendChild(li);});
        var l=document.createElement('a'); l.className='text-link'; l.href='https://app.autodeck.in'; l.textContent='Sign in on the app for price and details';
        var n=document.createElement('p'); n.className='held-note'; n.textContent='Price requests continue in the app.';
        d.appendChild(e);d.appendChild(h);d.appendChild(ul);d.appendChild(l);d.appendChild(n);a.appendChild(d);box.appendChild(a);
      });
      if(box.children.length){box.hidden=false; if(empty) empty.hidden=true;}
    }).catch(function(){});
})();
</script>
</Base>
