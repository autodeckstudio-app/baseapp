---
import Base from '../layouts/Base.astro';
import '../styles/cars.css';
import rawCars from '../data/cars.json';
import { validatePublicCars } from '../data/public-cars.mjs';
const cars = validatePublicCars(rawCars);
const appUrl = 'https://app.autodeck.in';
---
<Base title="Cars · AutoDeck" description="Buy and sell cars with AutoDeck. Explore our held-car showcase, with price enquiries and further details in the app." page="cars">
<section class="cars-opening wrap"><div><p class="eyebrow"><i></i> AutoDeck cars</p><h1>Your next drive.<br /><em>Your next chapter.</em></h1><p class="intro">We buy and sell cars.<br />Start your next move with AutoDeck.</p><a class="text-link" href="#held-cars">Explore the showcase ↓</a></div><div class="cars-paths"><article><span>01 / Buy</span><h2>Find your next car.</h2><p>Explore the cars we hold, then continue in the app for price enquiries and further details.</p><a href={appUrl} class="text-link">Sign in on the app ↗</a></article><article><span>02 / Sell</span><h2>Make room for what's next.</h2><p>Tell us about your car in the app.</p><a href={appUrl} class="text-link">Start in the app ↗</a></article></div></section>
<section id="held-cars" class="held-cars wrap" aria-labelledby="held-heading"><div class="held-head"><div><p class="eyebrow">The AutoDeck showcase</p><h2 id="held-heading">Cars we hold.</h2></div><p>Public showcase.<br />Private details stay in the app.</p></div>
{cars.length ? <div class="held-grid">{cars.map(car=><article class="held-card"><div class="held-photo"><img src={car.photo} alt={car.photoAlt} loading="lazy"/></div><div class="held-copy"><p class="eyebrow">{car.year || 'AutoDeck cars'}</p><h3>{car.make} {car.model}{car.variant ? ` ${car.variant}` : ''}</h3><ul aria-label="Public car specifications">{[car.kilometres !== undefined ? `${car.kilometres.toLocaleString('en-IN')} km` : null,car.fuel,car.transmission,car.bodyStyle].filter(Boolean).map(spec=><li>{spec}</li>)}</ul><a class="text-link" href={appUrl}>Sign in on the app for price and details ↗</a><p class="held-note">Price requests continue in the app.</p></div></article>)}</div> : <div class="held-empty"><span aria-hidden="true">↗</span><div><h3>Inventory updates to follow.</h3><p>Our held-car showcase is being prepared. No cars are listed on this page yet.</p><a href={appUrl} class="text-link">Sign in on the app for price enquiries and details ↗</a></div></div>}
<div class="cars-privacy"><p>No number plates, owner information or prices are published in this showcase.</p><p>Continue in the app to sign in and enquire. This page does not check your app sign-in.</p></div>
</section>
</Base>
