---
import Base from '../layouts/Base.astro';
---
<Base
  title="The Accessory Lounge · AutoDeck"
  description="AutoDeck merch and car-care essentials, curated the same way we pick our coatings. On the shelf from opening day, Friday 16 October."
  page="lounge"
>
  <section class="phero"><div class="wrap">
    <p class="eyebrow">The Accessory Lounge</p>
    <h1>Wear the shield. <em>Stock the shelf.</em></h1>
    <p class="lede">Merch and care essentials, chosen the way we choose our coatings. On the shelf from Friday 16 October.</p>
  </div></section>
  <section class="s"><div class="wrap">
    <div class="grid3">
      <div class="card rv"><span class="n">01</span><h3>Studio Tee</h3><p>Opening collection.</p></div>
      <div class="card rv"><span class="n">02</span><h3>Shield Cap</h3><p>Opening collection.</p></div>
      <div class="card rv"><span class="n">03</span><h3>Care Kit</h3><p>Studio-approved products.</p></div>
    </div>
    <p class="more rv">The shelf opens with the studio. First drops are announced on <a class="link" href="https://instagram.com/autodeck.studio" target="_blank" rel="noopener">@autodeck.studio</a>.</p>
  </div></section>
</Base>
