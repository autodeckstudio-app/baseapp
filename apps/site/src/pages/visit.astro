---
import Base from '../layouts/Base.astro';
---
<Base
  title="Visit · AutoDeck, Sunbeam Complex, Ellisbridge"
  description="AutoDeck, Sunbeam Complex, Old Sharda Mandir Rd, Ellisbridge, Ahmedabad 380006. Mon to Sat 10 am to 9 pm, Sunday 10 am to 7 pm. +91 98986 79711."
  page="visit"
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="hero-eyebrow rv-e">04 / Visit the studio</p>
      <h1 class="hero-title">
        <span class="line"><span>Sunbeam Complex,</span></span>
        <span class="line"><span><em>Ellisbridge.</em></span></span>
      </h1>
      <p class="hero-sub rv-e">One address for the garage, the lab, the wash studio and the lounge. Doors open Sunday 11 October.</p>
    </div>
  </section>

  <section class="section visit">
    <div class="visit-banner rv px-img">
      <img src="/assets/img/storefront.jpg" alt="The AutoDeck storefront at Sunbeam Complex" data-px />
    </div>
    <div class="visit-grid">
      <div class="visit-block rv">
        <span class="label">Address</span>
        <p>Sunbeam Complex, Old Sharda Mandir Rd,<br />Ellisbridge, Ahmedabad, Gujarat 380006</p>
        <p style="margin-top: 14px;"><a class="inline" href="https://www.google.com/maps/search/?api=1&query=Sunbeam+Complex+Old+Sharda+Mandir+Rd+Ellisbridge+Ahmedabad" target="_blank" rel="noopener">Get directions ↗</a></p>
      </div>
      <div class="visit-block rv">
        <span class="label">Hours</span>
        <p>Mon to Sat, 10 am to 9 pm<br />Sunday, 10 am to 7 pm</p>
        <p style="margin-top: 14px;">Grand opening: Sunday 11 October, 10 am</p>
      </div>
      <div class="visit-block rv">
        <span class="label">Talk to us</span>
        <p><a class="inline" href="tel:+919898679711">+91 98986 79711</a><br /><a class="inline" href="https://instagram.com/autodeck.studio" target="_blank" rel="noopener">@autodeck.studio</a></p>
      </div>
    </div>
  </section>
</Base>
