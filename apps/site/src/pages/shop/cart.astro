---
import Base from '../../layouts/Base.astro';
import '../../styles/store.css';
const dev = import.meta.env.DEV;
---
<style is:global>[data-cart] form{display:grid;gap:12px;max-width:420px;margin-top:18px}[data-cart] label{display:grid;gap:4px;font-size:13px;opacity:.85}[data-cart] input{padding:12px;border-radius:10px;border:1px solid #333;background:#0d0d0f;color:#fff;font:inherit}[data-cart] button[type=submit]{padding:14px;border-radius:999px;border:0;background:#fff;color:#000;font-weight:600}[data-cart] ul{padding-left:18px}[data-cart-result]{margin-top:14px;font-weight:600}</style>
<Base title="Cart · AutoDeck Store" description="Your AutoDeck Store cart." page="shop">
<section class="wrap" style="padding:120px 0 60px">
  <h1>Cart</h1>
  {dev ? (
    <div data-cart data-order-url="http://127.0.0.1:8796/order">
      <p class="store-status"><i></i> FIXTURE flow, local only. No payment is taken.</p>
      <ul data-cart-lines></ul>
      <form>
        <label>Full name <input name="name" required /></label>
        <label>Mobile <input name="mobile" inputmode="numeric" required /></label>
        <label>Email (optional) <input name="email" type="email" /></label>
        <label>Address <input name="address" required /></label>
        <label>City <input name="city" required /></label><label>State <input name="state" required /></label><label>Pincode <input name="pincode" inputmode="numeric" required /></label>
        <button type="submit">Place TEST order</button>
      </form>
      <p data-cart-result></p>
    </div>
  ) : (
    <p class="store-small">Ordering is not open yet.</p>
  )}
  <p><a href="/shop">Back to the store</a></p>
</section>
{dev && <script>import '../../scripts/cart.js';</script>}
</Base>
