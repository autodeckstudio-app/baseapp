---
import Base from '../layouts/Base.astro';
const items = [
  ['01','Paint Protection Film','Self-healing film, cut to your car and nothing else.','Detailing Lab'],
  ['02','Ceramic Coating','Five years of gloss, on record, with a 6-monthly check to keep it honest.','Detailing Lab'],
  ['03','Detailing','Paint corrected under studio light, then measured. Seen, never just promised.','Detailing Lab'],
  ['04','Washing','Foam, two buckets, clean mitts. The wash it should always have been.','Wash Studio'],
  ['05','Garage','Repairs and service, with updates on your car from anywhere.','Performance Garage'],
  ['06','Modification','Upgrades chosen with care, fitted right the first time.','Accessory Lounge'],
];
---
<Base
  title="Services · AutoDeck"
  description="Paint protection film, ceramic coating, detailing, washing, garage and modification, six crafts under one roof in Ahmedabad. Every service and your car's price is in the app."
  page="services"
>
  <section class="phero"><div class="wrap">
    <p class="eyebrow">The six things we do</p>
    <h1>Every service. One roof. <em>Nothing outsourced.</em></h1>
    <p class="lede">The work measured, photographed and on record, not claimed. Every service, with your car's exact price, is in the app.</p>
    <div class="actions" style="margin-top:26px"><a class="btn" href="https://app.autodeck.in">Open the app <span aria-hidden="true">&rarr;</span></a></div>
  </div></section>
  <section class="s" style="padding-top:56px"><div class="wrap">
    <ul class="rows">
      {items.map(([k,n,d,z]) => <li class="rv"><span class="k">{k}</span><h2>{n}</h2><p>{d}</p><span class="z">{z}</span></li>)}
    </ul>
    <div class="cta-box rv" style="margin-top:72px">
      <div><h2>59 services. Every price in the app.</h2><p>Pick your car and see its exact price before you book. Final price confirmed after paint inspection. Garage work and modifications are quoted after we see the car.</p></div>
      <div class="actions"><a class="btn dark" href="https://app.autodeck.in">See your car's prices <span aria-hidden="true">&rarr;</span></a></div>
    </div>
  </div></section>
</Base>
