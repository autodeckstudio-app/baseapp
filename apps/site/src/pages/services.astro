---
import Base from '../layouts/Base.astro';
const categories = [
 ['01','Paint protection film','A protective layer for the finish you want to keep.'],
 ['02','Ceramic coating','Surface protection, with a finish that stays easy to care for.'],
 ['03','Detailing','A closer look at paint, cabin and the details between.'],
 ['04','Washing','A fresh start for the everyday drive.'],
 ['05','Garage','Service and repairs, all connected to your car.'],
 ['06','Modifications','Make it yours. Explore the possibilities with the studio.'],
];
---
<Base title="Services + app · AutoDeck" description="PPF, ceramic coating, detailing, washing, garage and modifications. Explore service categories, then book in the AutoDeck app." page="services">
<section class="page-head wrap"><p class="eyebrow">The studio menu</p><h1>For every kind <em>of care.</em></h1><div class="head-bottom"><p class="intro">Six categories. The full menu lives in the app.</p><a class="button" href="https://app.autodeck.in">Explore in the app ↗</a></div></section>
<section class="wrap editorial-grid"><figure class="side-photo reveal"><img src="/assets/img/stock-wash.jpg" alt="Gloved hand polishing a car headlight. Illustrative stock photograph."/><figcaption>Illustrative photography</figcaption></figure><div class="service-list">{categories.map(([n,t,d])=><article class="reveal"><small>{n}</small><div><h2>{t}</h2><p>{d}</p></div></article>)}</div></section>
<section class="section wrap"><div class="connected glass" id="app"><div><p class="eyebrow">The AutoDeck app</p><h2>Your car care.<br />One place.</h2><a class="button" href="https://app.autodeck.in">Open the app ↗</a></div><div class="connected-steps"><article><small>01 / Before</small><h3>Choose and book.</h3><p>Your car, the full menu and your next visit.</p></article><article><small>02 / During</small><h3>Stay connected.</h3><p>Updates and approvals, without the back and forth.</p></article><article><small>03 / After</small><h3>Keep the record.</h3><p>Invoices and service history, ready when you need them.</p></article></div></div></section></Base>
