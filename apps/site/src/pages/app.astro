---
import Base from '../layouts/Base.astro';
---
<Base
  title="The App · AutoDeck"
  description="Digital job cards with photos at every stage, warranty and service history on record, published prices and a maintenance calendar. The record follows the car."
  page="app"
>
  <div class="paper-wrap">
    <section class="page-hero light">
      <div class="page-hero-inner">
        <p class="hero-eyebrow rv-e">02 / The AutoDeck app</p>
        <h1 class="hero-title">
          <span class="line"><span>The record</span></span>
          <span class="line"><span>follows <em>the car.</em></span></span>
        </h1>
        <p class="hero-sub rv-e">Not a booking form. The car's whole life at the studio, kept, photographed and provable, in your pocket.</p>
        <div class="hero-actions rv-e">
          <a class="btn magnetic" href="https://app.autodeck.in"><span class="btn-label">Open the app</span><span class="arr">→</span></a>
        </div>
        <p class="app-note rv-e">Runs in your browser today. App Store and Play Store soon.</p>
      </div>
    </section>

    <section class="section appsec">
      <div class="appsec-grid">
        <div class="app-feats">
          <div class="rv">
            <h3>Watch the work</h3>
            <p>Digital job cards with photos at every stage, as they happen.</p>
          </div>
          <div class="rv">
            <h3>Prove it years later</h3>
            <p>Ceramic warranty, service history and documents, on record in your pocket.</p>
          </div>
          <div class="rv">
            <h3>Know the price first</h3>
            <p>Published prices before the car comes in. No "come and we will see".</p>
          </div>
          <div class="rv">
            <h3>Never miss a date</h3>
            <p>Maintenance calendar and reminders, kept for you.</p>
          </div>
        </div>
        <figure class="appsec-figure rv px-img">
          <img src="/assets/img/studio-bay.jpg" alt="Inside the AutoDeck studio" data-px />
          <span class="tag">The studio · Ellisbridge</span>
        </figure>
      </div>
    </section>
  </div>
</Base>
