---
import Base from '../layouts/Base.astro';
import gallery from '../data/gallery.json';
---
<Base
  title="Gallery · AutoDeck"
  description="Inside the AutoDeck studio in Ellisbridge, Ahmedabad: the bays, the products and the work."
  page="gallery"
>
  <section class="phero"><div class="wrap">
    <p class="eyebrow">Gallery</p>
    <h1>The studio, <em>and the work.</em></h1>
    <p class="lede">A look inside the garage in Ellisbridge. More of the work lands here as cars leave the bay.</p>
  </div></section>
  <section class="sec"><div class="wrap">
    <div class="gal">
      {gallery.map((g) => (
        <figure class={g.size === 'wide' ? 'wide' : g.size === 'tall' ? 'tall' : ''}>
          <img src={g.src} alt={g.alt} loading="lazy" />
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div></section>
</Base>
