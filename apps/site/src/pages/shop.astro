---
import Base from '../layouts/Base.astro';
import ProductArt from '../components/ProductArt.astro';
import products from '../data/shop.json';
---
<Base title="Shop · AutoDeck" description="A preview of the AutoDeck car-culture collection: clothing, care essentials and everyday gear. Product range to be confirmed." page="shop"><section class="page-head wrap"><p class="eyebrow">Car culture, off the clock</p><h1>For the drive.<br /><em>And everything after.</em></h1><div class="head-bottom"><p class="intro">Wear it. Carry it. Make it yours.</p><span class="pill">Catalogue preview · Not for sale yet</span></div></section><section class="wrap shop-intro"><img src="/assets/img/studio-orange-bay.jpg" alt="AutoDeck T-shirt design concept from its archive"/><div><p class="eyebrow">The collection, in progress</p><h2>More than a logo.</h2><p>Gear for people who care about cars.</p><p class="muted">Studio Tee, Shield Cap and Care Kit are the existing range names. The wider collection below is proposed. All illustrations are placeholders. Products, photos, specifications and prices need confirmation before ordering opens.</p></div></section><section class="section wrap"><div class="filters" role="group" aria-label="Filter products">{['All','Wear','Care','Drive','Everyday'].map((c,i)=><button type="button" data-filter={c} aria-pressed={i===0}>{c}</button>)}</div><div class="product-grid">{products.map(p=><article class="product-card" data-category={p.category}><div class="product-art"><ProductArt kind={p.art}/><small>Placeholder illustration</small></div><div class="product-copy"><small>{p.category} · {p.status}</small><h2>{p.name}</h2><p>Preview only · Price not set</p></div></article>)}</div><p class="shop-note">Nothing here can be purchased yet. This preview is for choosing the collection, not an announcement of availability.</p></section></Base>
