---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import '../styles/store.css';
import collection from '../data/shop.json';
interface Product {
  id: string; name: string; department: 'Scent' | 'Clothing' | 'Car accessories'; price?: number; description: string;
  image: string; imageAlt: string; detailImage?: string; detailImageAlt?: string;
  provenance?: 'Made for AutoDeck' | 'Selected by AutoDeck'; maker?: string;
  details: { label: string; value: string }[];
}
interface Edition { title: string; description: string; image: string; imageAlt: string }
const products = (collection.products as Product[]).filter(p => p.id && p.name && p.image && p.imageAlt);
const edition = collection.edition as Edition | null;
---
<Base title="Store · AutoDeck" description="The AutoDeck edit. Scent, clothing and car accessories, with the collection still taking shape." page="shop">
<div class="store-bar" role="region" aria-label="Store"><div class="wrap store-bar-row"><span class="store-bar-name">AutoDeck Store</span><span class="store-bar-status"><i></i> Opening soon. Not taking orders yet.</span><nav aria-label="Departments"><a href="#collection" data-department="All">All</a><a href="#collection" data-department="Scent">Scent</a><a href="#collection" data-department="Clothing">Clothing</a><a href="#collection" data-department="Car accessories">Car accessories</a></nav></div></div>
<section class="store-opening wrap" aria-labelledby="store-heading">
  <div class="store-title"><p class="eyebrow"><i></i> The AutoDeck edit</p><h1 id="store-heading">Objects with<br />a point of <em>view.</em></h1><p class="intro">Scent. Clothing. Car accessories.<br />A collection taking shape.</p><a class="text-link" href="#collection">Explore the edit <Arrow dir="s" /></a></div>
  {edition ? <figure class="edition-feature"><img src={edition.image} alt={edition.imageAlt} fetchpriority="high"/><figcaption><p class="eyebrow">AutoDeck Editions</p><h2>{edition.title}</h2><p>{edition.description}</p></figcaption></figure> : <div class="edition-statement"><div class="edition-top"><span>AutoDeck Editions</span><span class="edition-status"><i></i> In the making</span></div><p class="edition-line">A different<br />kind of <span>collection.</span></p><div class="edition-bottom"><span>Chosen with intent.<br />Not a logo on everything.</span><a href="#collection" aria-label="Explore the collection" class="edition-arrow"><Arrow dir="se" /></a></div></div>}
</section>
<section class="store-departments wrap" aria-label="Explore departments"><a href="#collection" data-department="Scent"><span class="department-number">01</span><div><h2>Scent</h2><p>A new direction for AutoDeck.</p></div><span aria-hidden="true"><Arrow /></span></a><a href="#collection" data-department="Clothing"><span class="department-number">02</span><div><h2>Clothing</h2><p>Beyond the badge.</p></div><span aria-hidden="true"><Arrow /></span></a><a href="#collection" data-department="Car accessories"><span class="department-number">03</span><div><h2>Car accessories</h2><p>Covers, key chains and more for people who love cars.</p></div><span aria-hidden="true"><Arrow /></span></a></section>
<section class="store-collection wrap" id="collection" aria-labelledby="collection-heading"><div class="collection-head"><div><p class="eyebrow">Browse the collection</p><h2 id="collection-heading">The edit.</h2></div><div class="store-filters" role="group" aria-label="Filter collection">{['All', 'Scent', 'Clothing', 'Car accessories'].map((d,i)=><button type="button" data-store-filter={d} aria-pressed={i===0}>{d}</button>)}</div></div>
<div class="store-products">{products.map(p=><article class="store-product" data-store-category={p.department}><button class="product-open" data-open-product={`product-${p.id}`} aria-haspopup="dialog"><div class="store-product-photo"><img src={p.image} alt={p.imageAlt} loading="lazy" />{p.detailImage && <img class="store-product-detail-photo" src={p.detailImage} alt="" loading="lazy"/>}<span>Quick view <Arrow /></span></div><div class="store-product-name"><p>{p.department}{p.provenance && ` · ${p.provenance}`}</p><h3>{p.name}</h3>{typeof p.price === 'number' && <span class="store-price">Rs {p.price.toLocaleString('en-IN')}</span>}</div></button><noscript><p>{p.description}</p><dl>{p.details.map(d=><div><dt>{d.label}</dt><dd>{d.value}</dd></div>)}</dl></noscript><dialog id={`product-${p.id}`} class="product-dialog" aria-labelledby={`title-${p.id}`}><button class="dialog-close" type="button" data-close-product aria-label="Close product details"><Arrow close /></button><div class="product-dialog-grid"><div class="dialog-photos"><img src={p.image} alt={p.imageAlt} loading="lazy"/>{p.detailImage && <img src={p.detailImage} alt={p.detailImageAlt || p.imageAlt} loading="lazy"/>}</div><div class="dialog-copy"><p class="eyebrow">{p.department}</p><h2 id={`title-${p.id}`}>{p.name}</h2><p>{p.description}</p>{p.provenance && <p class="provenance">{p.provenance}{p.maker && ` · ${p.maker}`}</p>}<dl>{p.details.map(d=><div><dt>{d.label}</dt><dd>{d.value}</dd></div>)}</dl><p class="store-small">Preview only. Ordering is not open.</p></div></div></dialog></article>)}</div>
<div class="collection-empty" hidden={products.length>0}><span class="empty-mark" aria-hidden="true"><Arrow /></span><div><h3 data-empty-title>Collection in the making.</h3><p data-empty-copy>Products and details will appear here when they are ready. Nothing is available to order yet.</p></div></div>
<p class="store-small collection-footnote">Scent, clothing and car accessories are the starting point. Product details are still being finalised.</p>
</section>
<section class="store-promise wrap" aria-labelledby="promise-heading"><div class="collection-head"><div><p class="eyebrow">How we choose</p><h2 id="promise-heading">Made for us, or chosen by us.</h2></div></div><div class="promise-grid"><div><span>01</span><h3>Made for AutoDeck</h3><p>Pieces we design or have made ourselves for our own brand.</p></div><div><span>02</span><h3>Selected by AutoDeck</h3><p>Pieces we pick because we would use them. Each one says who makes it.</p></div><div><span>03</span><h3>Not a logo on everything</h3><p>We are not selling logo merchandise. Every product has to earn its place.</p></div></div></section>
<script>import '../scripts/store.js';</script>
</Base>
