---
import '../styles/studio.css';
import { localBusiness } from '../data/local-business.mjs';
interface Props {
  title: string;
  description: string;
  page?: string;
  noindex?: boolean;
}
const { title, description, page = '', noindex = false } = Astro.props;
const ogImage = 'https://www.autodeck.in/assets/og.png';
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', 'https://www.autodeck.in').href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex,follow" /> : null}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:site_name" content="AutoDeck" />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:url" content={canonical} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body class={page}>
  <header class="header"><div class="wrap header-row"><a href="/" class="logo" aria-label="AutoDeck home"><img src="/assets/logo-horizontal.svg" alt="AutoDeck" width="156" height="34" /></a><nav aria-label="Main"><a href="/#app">App</a><a href="/cars" aria-current={page === 'cars' ? 'page' : undefined}>Cars</a><a href="/shop" aria-current={page === 'shop' ? 'page' : undefined}>Store</a></nav></div></header>
  <main><slot /></main>
  <footer class="footer"><div class="wrap footer-row"><a class="logo" href="/" aria-label="AutoDeck home"><img src="/assets/logo-horizontal.svg" alt="AutoDeck" width="130" height="28" /></a><p>Complete car care. All under one roof.</p><p>Sunbeam Complex, Old Sharda Mandir Rd, Ellisbridge, Ahmedabad 380006. Mon to Sat 10 am to 9 pm, Sun 10 am to 7 pm.</p><div><a href="tel:+919898679711">+91 98986 79711</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/faq">FAQ</a></div></div></footer>
  <script>import '../scripts/studio.js';</script>
</body></html>
