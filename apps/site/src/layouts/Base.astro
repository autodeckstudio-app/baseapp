---
interface Props {
  title: string;
  description: string;
  page?: string;
}
const { title, description, page = '' } = Astro.props;
const ogImage = 'https://www.autodeck.in/assets/og.png';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body class={page}>
  <div class="grain" aria-hidden="true"></div>

  <header class="site-head">
    <a class="brand" href="/" aria-label="AutoDeck home"><img src="/assets/logo-horizontal.svg" alt="AutoDeck" /></a>
    <nav aria-label="Pages">
      <a href="/services" aria-current={page === 'services' ? 'page' : undefined}>Services</a>
      <a href="/app" aria-current={page === 'app' ? 'page' : undefined}>App</a>
      <a href="/lounge" aria-current={page === 'lounge' ? 'page' : undefined}>Lounge</a>
      <a href="/visit" aria-current={page === 'visit' ? 'page' : undefined}>Visit</a>
      <a class="head-cta" href="https://app.autodeck.in">Book a slot</a>
    </nav>
  </header>

  <main id="top">
    <slot />
  </main>

  <footer class="site-foot">
    <div class="foot-word" aria-hidden="true">AutoDeck</div>
    <div class="foot-row">
      <span>Sunbeam Complex, Ellisbridge, Ahmedabad · +91 98986 79711</span>
      <span>© 2026 AutoDeck · Made in Ahmedabad</span>
    </div>
  </footer>

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
