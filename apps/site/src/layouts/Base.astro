---
import '../styles/site.css';
interface Props {
  title: string;
  description: string;
  page?: string;
}
const { title, description, page = '' } = Astro.props;
const ogImage = 'https://www.autodeck.in/assets/og.png';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body class={page}>
  <header class="site-head">
    <div class="wrap">
      <a class="brand" href="/" aria-label="AutoDeck home"><img src="/assets/logo-horizontal-dark.svg" alt="AutoDeck" /></a>
      <nav aria-label="Pages">
        <a href="/services" aria-current={page === 'services' ? 'page' : undefined}>Services</a>
        <a href="/app" aria-current={page === 'app' ? 'page' : undefined}>The app</a>
        <a href="/lounge" aria-current={page === 'lounge' ? 'page' : undefined}>Lounge</a>
        <a href="/visit" aria-current={page === 'visit' ? 'page' : undefined}>Visit</a>
        <a class="btn sm" href="https://app.autodeck.in">Book a slot</a>
      </nav>
    </div>
    <nav class="mnav" aria-label="Pages">
      <a href="/services" aria-current={page === 'services' ? 'page' : undefined}>Services</a>
      <a href="/app" aria-current={page === 'app' ? 'page' : undefined}>The app</a>
      <a href="/lounge" aria-current={page === 'lounge' ? 'page' : undefined}>Lounge</a>
      <a href="/visit" aria-current={page === 'visit' ? 'page' : undefined}>Visit</a>
    </nav>
  </header>

  <main id="top"><slot /></main>

  <footer class="site-foot">
    <div class="wrap">
      <div class="foot-grid">
        <div><img src="/assets/logo-horizontal-dark.svg" alt="AutoDeck" /><p>Complete car care. All under one roof.</p></div>
        <div><h4>Studio</h4><p>Sunbeam Complex, Old Sharda Mandir Rd<br />Ellisbridge, Ahmedabad 380006</p><a href="tel:+919898679711">+91 98986 79711</a></div>
        <div><h4>Explore</h4><a href="/services">Services</a><a href="/app">The app</a><a href="/lounge">Lounge</a><a href="/visit">Visit</a><a href="https://instagram.com/autodeck.studio" target="_blank" rel="noopener">@autodeck.studio</a></div>
      </div>
      <p class="legal">© 2026 AutoDeck · Made in Ahmedabad</p>
    </div>
  </footer>

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
