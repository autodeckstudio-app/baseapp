{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/services",
      "destination": "/#services",
      "statusCode": 301
    },
    {
      "source": "/gallery",
      "destination": "/#studio",
      "statusCode": 301
    },
    {
      "source": "/app",
      "destination": "/#app",
      "statusCode": 301
    },
    {
      "source": "/visit",
      "destination": "/#visit",
      "statusCode": 301
    },
    {
      "source": "/lounge",
      "destination": "/shop",
      "statusCode": 301
    },
    {
      "source": "/login",
      "destination": "https://app.autodeck.in/login",
      "permanent": false
    },
    {
      "source": "/setup",
      "destination": "https://app.autodeck.in/setup",
      "permanent": false
    },
    {
      "source": "/staff",
      "destination": "https://app.autodeck.in/staff",
      "permanent": false
    },
    {
      "source": "/welcome",
      "destination": "https://app.autodeck.in/welcome",
      "permanent": false
    },
    {
      "source": "/sell",
      "destination": "https://app.autodeck.in/sell",
      "permanent": false
    },
    {
      "source": "/approvals/:path*",
      "destination": "https://app.autodeck.in/approvals/:path*",
      "permanent": false
    },
    {
      "source": "/book/:path*",
      "destination": "https://app.autodeck.in/book/:path*",
      "permanent": false
    },
    {
      "source": "/bookings/:path*",
      "destination": "https://app.autodeck.in/bookings/:path*",
      "permanent": false
    },
    {
      "source": "/cars/:path+",
      "destination": "https://app.autodeck.in/cars/:path+",
      "permanent": false
    },
    {
      "source": "/catalogue/:path*",
      "destination": "https://app.autodeck.in/catalogue/:path*",
      "permanent": false
    },
    {
      "source": "/garage/:path*",
      "destination": "https://app.autodeck.in/garage/:path*",
      "permanent": false
    },
    {
      "source": "/help",
      "destination": "https://app.autodeck.in/help",
      "permanent": false
    },
    {
      "source": "/membership/:path*",
      "destination": "https://app.autodeck.in/membership/:path*",
      "permanent": false
    },
    {
      "source": "/notifications/:path*",
      "destination": "https://app.autodeck.in/notifications/:path*",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "https://app.autodeck.in/profile",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://asia-south1-autodeck-studio.cloudfunctions.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "ignoreCommand": "bash ../../scripts/vercel-ignore.sh site"
}
