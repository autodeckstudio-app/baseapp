{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/login", "destination": "https://baseapp-customer.vercel.app/login", "permanent": false },
    { "source": "/setup", "destination": "https://baseapp-customer.vercel.app/setup", "permanent": false },
    { "source": "/staff", "destination": "https://baseapp-customer.vercel.app/staff", "permanent": false },
    { "source": "/welcome", "destination": "https://baseapp-customer.vercel.app/welcome", "permanent": false },
    { "source": "/sell", "destination": "https://baseapp-customer.vercel.app/sell", "permanent": false },
    { "source": "/services", "destination": "https://baseapp-customer.vercel.app/services", "permanent": false },
    { "source": "/approvals/:path*", "destination": "https://baseapp-customer.vercel.app/approvals/:path*", "permanent": false },
    { "source": "/book/:path*", "destination": "https://baseapp-customer.vercel.app/book/:path*", "permanent": false },
    { "source": "/bookings/:path*", "destination": "https://baseapp-customer.vercel.app/bookings/:path*", "permanent": false },
    { "source": "/cars/:path*", "destination": "https://baseapp-customer.vercel.app/cars/:path*", "permanent": false },
    { "source": "/catalogue/:path*", "destination": "https://baseapp-customer.vercel.app/catalogue/:path*", "permanent": false },
    { "source": "/garage/:path*", "destination": "https://baseapp-customer.vercel.app/garage/:path*", "permanent": false },
    { "source": "/help", "destination": "https://baseapp-customer.vercel.app/help", "permanent": false },
    { "source": "/membership/:path*", "destination": "https://baseapp-customer.vercel.app/membership/:path*", "permanent": false },
    { "source": "/notifications/:path*", "destination": "https://baseapp-customer.vercel.app/notifications/:path*", "permanent": false },
    { "source": "/profile", "destination": "https://baseapp-customer.vercel.app/profile", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
