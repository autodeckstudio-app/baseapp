# AutoDeck admin-web — local development, emulator-only.
# Copy to .env.local (gitignored) if you need to override a default.
# Every value below is either an obviously-fake placeholder safe for the
# Firebase Auth EMULATOR only, or points at the local backend — never a
# real credential. NEXT_PUBLIC_* is Next.js's mechanism for exposing a
# value to browser code, so nothing secret ever belongs here.

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-autodeck.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-autodeck
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
